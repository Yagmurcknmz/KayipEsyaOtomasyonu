@model IEnumerable<KayipEsyaOtomasyonu.Models.Eslesme>

@{
    ViewData["Title"] = "Eşleşme Yönetimi";
}

<style>
    @@keyframes pulsebekleyen{
        0%,100%{ box-shadow:0 10px 15px rgba(245,158,11,0.35); }
        50%{ box-shadow:0 16px 30px rgba(245,158,11,0.6), 0 0 0 10px rgba(245,158,11,0.18); }
    }
</style>

@{
    string DurumRengi(EslesmeDurumu d) => d switch
    {
        EslesmeDurumu.Beklemede   => "bg-warning bg-opacity-10 text-warning border-warning",
        EslesmeDurumu.Onaylandi   => "bg-success bg-opacity-10 text-success border-success",
        EslesmeDurumu.Reddedildi  => "bg-danger bg-opacity-10 text-danger border-danger",
        EslesmeDurumu.TeslimEdildi=> "bg-primary bg-opacity-10 text-primary border-primary",
        _                         => "bg-light text-dark"
    };
    string DurumRengiProgress(int s) => s switch
    {
        >= 80 => "bg-success",
        >= 55 => "bg-info",
        >= 35 => "bg-warning",
        _     => "bg-danger"
    };
    string DurumYazdir(EslesmeDurumu d) => d switch
    {
        EslesmeDurumu.Beklemede   => "Beklemede",
        EslesmeDurumu.Onaylandi   => "Onaylandı",
        EslesmeDurumu.Reddedildi  => "Reddedildi",
        EslesmeDurumu.TeslimEdildi=> "Teslim Edildi",
        _                         => d.ToString()
    };
    // Skor badge helper (renk+ikon):
    (string Sinif, string Ikon, string Etiket) SkorBilgi(int s) => s switch
    {
        >= 90 => ("skor-mukemmel",   "bi bi-stars",        "Mükemmel"),
        >= 75 => ("skor-yuksek",     "bi bi-check-circle-fill", "Yüksek"),
        >= 55 => ("skor-orta",       "bi bi-hand-thumbs-up",   "Orta"),
        >= 35 => ("skor-kismi",      "bi bi-exclamation-circle-fill", "Kısmi"),
        _     => ("skor-dusuk",      "bi bi-x-circle-fill",   "Düşük"),
    };
}

<div class="row justify-content-center">
    <div class="col-xxl-12 col-xl-12">

        @if (TempData["BasariliMesaj"] != null)
        {
            <div class="alert alert-success border-0 rounded-4 mb-3 d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-3"></i>
                <div>@TempData["BasariliMesaj"]</div>
            </div>
        }

        <!-- Header + İstatistik Kartları -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
            <div class="card-header bg-white py-3 border-0 border-bottom">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center justify-content-center bg-success bg-opacity-10 rounded-3" style="width:52px;height:52px;">
                            <i class="bi bi-arrow-left-right fs-3 text-success"></i>
                        </div>
                        <div>
                            <h4 class="mb-0 fw-bold">Eşleşme Yönetimi</h4>
                            <small class="text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                Kayıp başvuruları ile bulunan eşyalar arasındaki eşleşmeleri yönetin.
                            </small>
                        </div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">

                        <form asp-controller="Eslesme"
                              asp-action="OtomatikEsles"
                              method="post"
                              onsubmit="return confirm('Tüm aktif başvuruları bulunan eşyalar ile otomatik karşılaştıracak. Emin misiniz?');">
                            <input name="__RequestVerificationToken" type="hidden" value="@Html.AntiForgeryToken()"/>
                            <button type="submit"
                                    class="btn btn-success px-4 rounded-3 shadow-sm">
                                <i class="bi bi-magic me-1"></i>
                                Otomatik Tara &amp; Eşleştir
                            </button>
                        </form>

                        <a asp-controller="Eslesme"
                           asp-action="YeniEslesme"
                           class="btn btn-primary px-4 rounded-3 shadow-sm">
                            <i class="bi bi-plus-lg me-1"></i>
                            Manuel Eşleştir
                        </a>

                    </div>
                </div>
            </div>

            <div class="card-body bg-light bg-opacity-25 p-4">

                <!-- SEKMELİ DURUM FİLTRESİ (Her birinde SAYAC + AKTİF renkli) -->
                @{
                    var mevcutDurum = (EslesmeDurumu?)ViewBag.Durum;
                    int sToplam = ViewBag.SayacToplam ?? 0;
                    int sBekleyen = ViewBag.SayacBekleyen ?? 0;
                    int sOnaylanan = ViewBag.SayacOnaylanan ?? 0;
                    int sReddedilen = ViewBag.SayacReddedilen ?? 0;
                    int sTeslim = ViewBag.SayacTeslim ?? 0;
                }
                <div class="card border-0 rounded-4 shadow-sm mb-4 overflow-hidden">
                    <div class="card-body p-3 p-sm-4 d-flex flex-wrap gap-2 justify-content-between align-items-stretch"
                         style="background:linear-gradient(135deg,#fafafa 0%,#ffffff 100%);">

                        <!-- 1. TÜMÜ -->
                        <a asp-controller="Eslesme" asp-action="Index"
                           asp-route-ara="@ViewBag.Ara"
                           asp-route-kategoriId="@ViewBag.KategoriId"
                           class="btn d-flex flex-column flex-grow-1 align-items-center justify-content-center gap-1 rounded-3 fw-semibold py-3 px-2 px-sm-4
                                  @(mevcutDurum == null ? "text-white shadow-lg" : "bg-white border text-dark")"
                           style="@(mevcutDurum == null ? "background:linear-gradient(135deg,#0f172a 0%,#334155 100%);" : "min-width:150px;")">
                            <div class="d-flex align-items-center gap-2">
                                <i class="@(mevcutDurum == null ? "bi bi-grid-fill" : "bi bi-grid text-dark opacity-70")"></i>
                                <span class="text-nowrap">TÜM EŞLEŞMELER</span>
                            </div>
                            <div class="d-flex align-items-center gap-1 small">
                                <span class="badge rounded-pill @(mevcutDurum == null ? "bg-white text-dark" : "bg-secondary-subtle text-dark-emphasis") px-3 py-1 fw-bold">
                                    @sToplam
                                </span>
                                <span class="opacity-75 small">kayıt</span>
                            </div>
                        </a>

                        <!-- 2. BEKLEYEN -->
                        <a asp-controller="Eslesme" asp-action="Index"
                           asp-route-ara="@ViewBag.Ara"
                           asp-route-kategoriId="@ViewBag.KategoriId"
                           asp-route-durum="@nameof(EslesmeDurumu.Beklemede)"
                           class="btn d-flex flex-column flex-grow-1 align-items-center justify-content-center gap-1 rounded-3 fw-semibold py-3 px-2 px-sm-4
                                  @(mevcutDurum == EslesmeDurumu.Beklemede ? "text-white shadow-lg" : "bg-white border text-dark")"
                           style="@(mevcutDurum == EslesmeDurumu.Beklemede ? "background:linear-gradient(135deg,#f59e0b 0%,#ea580c 100%);animation:pulsebekleyen 2.5s ease infinite;" : "min-width:150px;")">
                            <div class="d-flex align-items-center gap-2">
                                <i class="@(mevcutDurum == EslesmeDurumu.Beklemede ? "bi bi-hourglass-split" : "bi bi-hourglass-split text-warning")"></i>
                                <span class="text-nowrap">BEKLEYEN</span>
                            </div>
                            <div class="d-flex align-items-center gap-1 small">
                                <span class="badge rounded-pill @(mevcutDurum == EslesmeDurumu.Beklemede ? "bg-white text-dark" : "bg-warning-subtle text-dark-emphasis") px-3 py-1 fw-bold">
                                    @sBekleyen
                                </span>
                                <span class="opacity-75 small">onay bekliyor</span>
                            </div>
                        </a>

                        <!-- 3. ONAYLANAN -->
                        <a asp-controller="Eslesme" asp-action="Index"
                           asp-route-ara="@ViewBag.Ara"
                           asp-route-kategoriId="@ViewBag.KategoriId"
                           asp-route-durum="@nameof(EslesmeDurumu.Onaylandi)"
                           class="btn d-flex flex-column flex-grow-1 align-items-center justify-content-center gap-1 rounded-3 fw-semibold py-3 px-2 px-sm-4
                                  @(mevcutDurum == EslesmeDurumu.Onaylandi ? "text-white shadow-lg" : "bg-white border text-dark")"
                           style="@(mevcutDurum == EslesmeDurumu.Onaylandi ? "background:linear-gradient(135deg,#16a34a 0%,#15803d 100%);" : "min-width:150px;")">
                            <div class="d-flex align-items-center gap-2">
                                <i class="@(mevcutDurum == EslesmeDurumu.Onaylandi ? "bi bi-check2-circle" : "bi bi-check2-circle text-success")"></i>
                                <span class="text-nowrap">ONAYLANAN</span>
                            </div>
                            <div class="d-flex align-items-center gap-1 small">
                                <span class="badge rounded-pill @(mevcutDurum == EslesmeDurumu.Onaylandi ? "bg-white text-dark" : "bg-success-subtle text-dark-emphasis") px-3 py-1 fw-bold">
                                    @sOnaylanan
                                </span>
                                <span class="opacity-75 small">teslim edilecek</span>
                            </div>
                        </a>

                        <!-- 4. REDDEDİLEN -->
                        <a asp-controller="Eslesme" asp-action="Index"
                           asp-route-ara="@ViewBag.Ara"
                           asp-route-kategoriId="@ViewBag.KategoriId"
                           asp-route-durum="@nameof(EslesmeDurumu.Reddedildi)"
                           class="btn d-flex flex-column flex-grow-1 align-items-center justify-content-center gap-1 rounded-3 fw-semibold py-3 px-2 px-sm-4
                                  @(mevcutDurum == EslesmeDurumu.Reddedildi ? "text-white shadow-lg" : "bg-white border text-dark")"
                           style="@(mevcutDurum == EslesmeDurumu.Reddedildi ? "background:linear-gradient(135deg,#dc2626 0%,#991b1b 100%);" : "min-width:150px;")">
                            <div class="d-flex align-items-center gap-2">
                                <i class="@(mevcutDurum == EslesmeDurumu.Reddedildi ? "bi bi-x-circle-fill" : "bi bi-x-circle-fill text-danger")"></i>
                                <span class="text-nowrap">REDDEDİLEN</span>
                            </div>
                            <div class="d-flex align-items-center gap-1 small">
                                <span class="badge rounded-pill @(mevcutDurum == EslesmeDurumu.Reddedildi ? "bg-white text-dark" : "bg-danger-subtle text-dark-emphasis") px-3 py-1 fw-bold">
                                    @sReddedilen
                                </span>
                                <span class="opacity-75 small">uyumsuz</span>
                            </div>
                        </a>

                        <!-- 5. TESLİM EDİLEN (TAMAMLANAN) -->
                        <a asp-controller="Eslesme" asp-action="Index"
                           asp-route-ara="@ViewBag.Ara"
                           asp-route-kategoriId="@ViewBag.KategoriId"
                           asp-route-durum="@nameof(EslesmeDurumu.TeslimEdildi)"
                           class="btn d-flex flex-column flex-grow-1 align-items-center justify-content-center gap-1 rounded-3 fw-semibold py-3 px-2 px-sm-4
                                  @(mevcutDurum == EslesmeDurumu.TeslimEdildi ? "text-white shadow-lg" : "bg-white border text-dark")"
                           style="@(mevcutDurum == EslesmeDurumu.TeslimEdildi ? "background:linear-gradient(135deg,#2563eb 0%,#1d4ed8 50%,#6366f1 100%);" : "min-width:150px;")">
                            <div class="d-flex align-items-center gap-2">
                                <i class="@(mevcutDurum == EslesmeDurumu.TeslimEdildi ? "bi bi-check2-all" : "bi bi-check2-all text-primary")"></i>
                                <span class="text-nowrap">TAMAMLANAN</span>
                            </div>
                            <div class="d-flex align-items-center gap-1 small">
                                <span class="badge rounded-pill @(mevcutDurum == EslesmeDurumu.TeslimEdildi ? "bg-white text-dark" : "bg-primary-subtle text-dark-emphasis") px-3 py-1 fw-bold">
                                    @sTeslim
                                </span>
                                <span class="opacity-75 small">sahibe teslim</span>
                            </div>
                        </a>
                    </div>
                </div>

                <!-- Filtreler (ARTIK SADECE: Arama + Kategori, Durum SEKMELERDEN yönetiliyor) -->
                <div class="card border rounded-3 shadow-sm mb-4">
                    <div class="card-body">
                        <form asp-controller="Eslesme" asp-action="Index" method="get">
                            @* Durum Query string: Sekmelerden zaten geliyor, ekle ki submit olunca kaybolmasın *@
                            if (mevcutDurum != null)
                            {
                                <input type="hidden" name="durum" value="@mevcutDurum.ToString()" />
                            }
                            <div class="row g-3 align-items-end">

                                <div class="col-md-5">
                                    <label class="form-label small text-uppercase text-muted fw-semibold mb-1">
                                        🔎 Kelime Arama
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white border-end-0">
                                            <i class="bi bi-search text-secondary"></i>
                                        </span>
                                        <input name="ara"
                                               value="@ViewBag.Ara"
                                               class="form-control border-start-0 ps-0"
                                               placeholder="Eşya adı, Marka, Model, Vatandaş adı soyadı ara..." />
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label small text-uppercase text-muted fw-semibold mb-1">
                                        📂 Kategori
                                    </label>
                                    <select name="kategoriId" class="form-select">
                                        <option value="">Tüm Kategoriler</option>
                                        @if (ViewBag.Kategoriler != null)
                                        {
                                            @foreach (var ktg in (List<Kategori>)ViewBag.Kategoriler)
                                            {
                                                if (ViewBag.KategoriId != null && (int?)ViewBag.KategoriId == ktg.Id)
                                                {
                                                    <option value="@ktg.Id" selected>@ktg.Ad</option>
                                                }
                                                else
                                                {
                                                    <option value="@ktg.Id">@ktg.Ad</option>
                                                }
                                            }
                                        }
                                    </select>
                                </div>

                                <div class="col-md-3 d-flex gap-2">
                                    <button type="submit" class="btn btn-primary w-100 rounded-3 fw-semibold shadow-sm">
                                        <i class="bi bi-filter me-1"></i>
                                        Filtrele
                                    </button>
                                    <a asp-controller="Eslesme" asp-action="Index" class="btn btn-outline-secondary rounded-3 shadow-sm">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                        <span class="d-none d-sm-inline ms-1">Sıfırla</span>
                                    </a>
                                </div>

                            </div>
                        </form>
                    </div>
                </div>

                <!-- Eşleşme Tablosu -->
                <div class="card border rounded-3 shadow-sm">
                    <div class="card-header bg-white py-2 border-bottom">
                        <h6 class="mb-0 fw-semibold text-primary d-flex align-items-center">
                            <i class="bi bi-list-ul me-2 fs-5"></i>
                            Eşleşme Listesi
                            <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1 ms-2">
                                @Model.Count() Kayıt
                            </span>
                        </h6>
                    </div>
                    <div class="card-body p-0">

                        @if (!Model.Any())
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-inbox display-4 text-muted opacity-25"></i>
                                <div class="mt-3 h5 text-muted mb-0">Henüz Eşleşme Bulunamadı</div>
                                <div class="small text-muted mt-1">
                                    Üstteki <strong>"Otomatik Tara &amp; Eşleştir"</strong> butonuna basarak ilk eşleşmeleri oluşturabilirsiniz.
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead class="bg-light">
                                        <tr class="small text-uppercase text-muted">
                                            <th class="ps-3">#</th>
                                            <th>Kayıp Başvuru</th>
                                            <th>Bulunan Eşya</th>
                                            <th>Eşleşme Skoru</th>
                                            <th>Tür</th>
                                            <th>Durum</th>
                                            <th>Tarih</th>
                                            <th class="text-end pe-3">İşlemler</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var e in Model)
                                        {
                                            <tr>
                                                <td class="ps-3 fw-bold">#@e.Id</td>
                                                <td style="min-width:250px;">
                                                    <div class="d-flex flex-column">
                                                        <span class="fw-semibold">
                                                            @e.KayipBildirimi?.EsyaAdi
                                                        </span>
                                                        <small class="text-muted">
                                                            <i class="bi bi-person me-1"></i>
                                                            @e.KayipBildirimi?.Vatandas?.Ad @e.KayipBildirimi?.Vatandas?.Soyad
                                                        </small>
                                                        <small class="text-muted">
                                                            <i class="bi bi-tag me-1"></i>
                                                            @e.KayipBildirimi?.Kategori?.Ad
                                                        </small>
                                                    </div>
                                                </td>
                                                <td style="min-width:250px;">
                                                    <div class="d-flex flex-column">
                                                        <span class="fw-semibold">
                                                            @e.KayipEsya?.EsyaAdi
                                                        </span>
                                                        <small class="text-muted">
                                                            <i class="bi bi-bookmark-star me-1"></i>
                                                            @e.KayipEsya?.Marka
                                                            @if (!string.IsNullOrEmpty(e.KayipEsya?.Renk))
                                                            {
                                                                <span class="ms-2"><i class="bi bi-palette me-1"></i>@e.KayipEsya.Renk</span>
                                                            }
                                                        </small>
                                                        <small class="text-muted">
                                                            <i class="bi bi-tag me-1"></i>
                                                            @e.KayipEsya?.Kategori?.Ad
                                                        </small>
                                                    </div>
                                                </td>
                                                <td style="min-width:230px;">
                                                    @{
                                                        var sb = SkorBilgi(e.Skor);
                                                    }
                                                    <div class="d-flex align-items-center gap-3 eslesme-progress-kapsul">
                                                        <div class="flex-grow-1">
                                                            <div class="progress" style="height:10px;">
                                                                <div class="progress-bar @DurumRengiProgress(e.Skor)"
                                                                     role="progressbar"
                                                                     style="width:@e.Skor%"
                                                                     aria-valuenow="@e.Skor"
                                                                     aria-valuemin="0"
                                                                     aria-valuemax="100">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <span class="skor-badge @sb.Sinif" title="@sb.Etiket benzerlik">
                                                            <i class="@sb.Ikon"></i>
                                                            <span>%@e.Skor</span>
                                                        </span>
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(e.EslesmeDetay))
                                                    {
                                                        <small class="text-muted d-block mt-1" style="font-size:.7rem;">
                                                            <i class="bi bi-lightbulb me-1"></i>
                                                            @e.EslesmeDetay
                                                        </small>
                                                    }
                                                </td>
                                                <td>
                                                    @if (e.Tur == EslesmeTuru.Otomatik)
                                                    {
                                                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1 rounded-pill">
                                                            <i class="bi bi-magic me-1"></i> Otomatik
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1 rounded-pill">
                                                            <i class="bi bi-hand-index me-1"></i> Manuel
                                                        </span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge @DurumRengi(e.Durum) border border-opacity-25 px-2 py-1 rounded-pill">
                                                        @if (e.Durum == EslesmeDurumu.Beklemede) { <text>⏳</text> }
                                                        else if (e.Durum == EslesmeDurumu.Onaylandi) { <text>✅</text> }
                                                        else if (e.Durum == EslesmeDurumu.Reddedildi) { <text>❌</text> }
                                                        else if (e.Durum == EslesmeDurumu.TeslimEdildi) { <text>📦</text> }
                                                        <text class="ms-1">@DurumYazdir(e.Durum)</text>
                                                    </span>
                                                </td>
                                                <td>
                                                    <small class="text-muted d-block">
                                                        <i class="bi bi-clock me-1"></i>
                                                        @e.OlusturmaTarihi.ToString("dd.MM.yyyy")
                                                    </small>
                                                    @if (e.IslemTarihi.HasValue)
                                                    {
                                                        <small class="text-muted d-block">
                                                            <i class="bi bi-check2 me-1"></i>
                                                            @e.IslemTarihi.Value.ToString("dd.MM.yyyy HH:mm")
                                                        </small>
                                                    }
                                                </td>
                                                <td class="text-end pe-3">
                                                    <div class="d-flex justify-content-end gap-1 flex-wrap">

                                                        <a asp-controller="Eslesme"
                                                           asp-action="Details"
                                                           asp-route-id="@e.Id"
                                                           class="btn btn-sm btn-outline-info rounded-2" title="Detay">
                                                            <i class="bi bi-eye"></i>
                                                        </a>

                                                        @if (e.Durum == EslesmeDurumu.Beklemede)
                                                        {
                                                            <form asp-controller="Eslesme"
                                                                  asp-action="Onayla"
                                                                  method="post"
                                                                  onsubmit="return confirm('Bu eşleşmeyi ONAYLAMAK istediğinize emin misiniz?');">
                                                                <input type="hidden" asp-for="@e.Id" name="id" value="@e.Id" />
                                                                <button type="submit"
                                                                        class="btn btn-sm btn-outline-success rounded-2"
                                                                        title="Onayla">
                                                                    <i class="bi bi-check2-circle"></i>
                                                                </button>
                                                            </form>

                                                            <form asp-controller="Eslesme"
                                                                  asp-action="Reddet"
                                                                  method="post"
                                                                  onsubmit="return confirm('Bu eşleşmeyi REDDETMEK istediğinize emin misiniz?');">
                                                                <input type="hidden" asp-for="@e.Id" name="id" value="@e.Id" />
                                                                <button type="submit"
                                                                        class="btn btn-sm btn-outline-danger rounded-2"
                                                                        title="Reddet">
                                                                    <i class="bi bi-x-circle"></i>
                                                                </button>
                                                            </form>
                                                        }

                                                        @if (e.Durum == EslesmeDurumu.Onaylandi)
                                                        {
                                                            <form asp-controller="Eslesme"
                                                                  asp-action="TeslimEt"
                                                                  method="post"
                                                                  onsubmit="return confirm('Bu eşleşme TESLİM EDİLDİ olarak işaretlensin mi?');">
                                                                <input type="hidden" asp-for="@e.Id" name="id" value="@e.Id" />
                                                                <button type="submit"
                                                                        class="btn btn-sm btn-outline-primary rounded-2"
                                                                        title="Teslim Edildi">
                                                                    <i class="bi bi-box"></i>
                                                                </button>
                                                            </form>
                                                        }

                                                        <form asp-controller="Eslesme"
                                                              asp-action="Sil"
                                                              method="post"
                                                              onsubmit="return confirm('Bu eşleşmeyi SİLMEK istediğinize emin misiniz?');">
                                                            <input type="hidden" asp-for="@e.Id" name="id" value="@e.Id" />
                                                            <button type="submit"
                                                                    class="btn btn-sm btn-outline-secondary rounded-2"
                                                                    title="Sil">

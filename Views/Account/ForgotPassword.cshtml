@model KayipEsyaOtomasyonu.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Şifremi Unuttum - Kayıp Eşya Sistemi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <style>
        body {
            background:
                radial-gradient(1000px 600px at 90% -10%, rgba(16,185,129,.22), transparent 55%),
                radial-gradient(800px 400px at -10% 110%, rgba(11,92,255,.22), transparent 60%),
                linear-gradient(135deg,#f0f4ff 0%,#f0fdf4 100%);
            background-attachment: fixed;
        }
    </style>
</head>
<body>

    <main class="min-vh-100 d-flex align-items-center justify-content-center px-3 py-5">
        <div class="card border-0 shadow-lg rounded-5 overflow-hidden" style="max-width:520px;width:100%;">

            <div class="p-4 p-md-5 text-white"
                 style="background:linear-gradient(135deg,#16a34a 0%,#0b5cff 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-4 bg-white bg-opacity-15 d-flex align-items-center justify-content-center"
                         style="width:58px;height:58px;font-size:30px;">
                        <i class="bi bi-key-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-4 mb-1">Şifrenizi Mi Unuttunuz?</div>
                        <div class="opacity-90 small">Kayıp Eşya Yönetim Sistemi</div>
                    </div>
                </div>
            </div>

            <div class="card-body p-4 p-md-5">

                <div class="mb-4 small text-muted">
                    <i class="bi bi-info-circle text-primary me-1"></i>
                    Hesabınıza kayıtlı e-posta adresinizi yazın. Size şifrenizi sıfırlamak için bir bağlantı gönderelim.
                </div>

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger rounded-4 border-0 mb-4 d-flex gap-2 align-items-start"
                     style="border-left:5px solid #dc2626;">
                    <i class="bi bi-x-circle-fill flex-shrink-0 mt-1"></i>
                    <span></span>
                </div>

                @{
                    var basariMesaji = (TempData["Mesaj"] as string) ?? (TempData["BasariliMesaj"] as string);
                    var hataMesaji = (TempData["HataMesaji"] as string);
                }

                @if (!string.IsNullOrWhiteSpace(basariMesaji))
                {
                    <div class="alert alert-success rounded-4 border-0 mb-4 d-flex gap-2 align-items-start"
                         style="border-left:5px solid #16a34a;">
                        <i class="bi bi-check-circle-fill flex-shrink-0 mt-1"></i>
                        <span>@basariMesaji</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(hataMesaji))
                {
                    <div class="alert alert-warning rounded-4 border-0 mb-4 d-flex gap-2 align-items-start"
                         style="border-left:5px solid #f59e0b;">
                        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1"></i>
                        <span>@hataMesaji</span>
                    </div>
                }

                <form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-semibold">
                            <i class="bi bi-envelope-fill me-1 text-primary"></i>
                            E-posta Adresi *
                        </label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text rounded-start-3 border border-secondary-subtle">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input asp-for="Email"
                                   type="email"
                                   class="form-control rounded-end-3 border border-secondary-subtle border-start-0"
                                   placeholder="ornek@arnavutkoy.bel.tr"
                                   autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="alert alert-info border-0 rounded-4 mb-4 d-flex gap-2 align-items-start small"
                         style="border-left:5px solid #0284c7;">
                        <i class="bi bi-shield-check flex-shrink-0 mt-1 text-info-emphasis"></i>
                        <div>
                            <strong class="text-info-emphasis">Gizlilik:</strong>
                            Kayıtlı e-posta bulunsun ya da bulunmasın size <strong>aynı mesaj</strong> gösterilir.
                            Kayıt yoksa e-posta <strong>gönderilmez</strong>.
                        </div>
                    </div>

                    <button type="submit"
                            class="btn btn-lg w-100 text-white rounded-4 shadow-sm fw-semibold"
                            style="background:linear-gradient(135deg,#16a34a,#0b5cff);border:0;">
                        <i class="bi bi-send-check me-2"></i>
                        Şifre Sıfırlama Linkini Gönder
                    </button>

                </form>

                <hr class="my-4" />

                <div class="d-flex flex-wrap justify-content-between gap-3 align-items-center">
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-outline-secondary rounded-4 px-4 fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i>
                        Girişe Dön
                    </a>
                    <a asp-controller="Account"
                       asp-action="Register"
                       class="btn btn-link fw-semibold">
                        Hesabım yok, hemen kayıt ol
                        <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>

            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

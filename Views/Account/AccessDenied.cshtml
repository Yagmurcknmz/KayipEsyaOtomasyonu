@{
    ViewData["Title"] = "Erişim Engellendi";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Erişim Engellendi - Kayıp Eşya Sistemi</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body class="login-page">

    <div class="d-flex align-items-center justify-content-center min-vh-100 px-3">

        <div class="card border-0 shadow-sm text-center"
             style="max-width: 560px; width: 100%;">

            <div class="card-body p-5">

                <div class="empty-state-icon mx-auto mb-4">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>

                <h2 class="mb-3">
                    Bu sayfaya erişim yetkiniz yok
                </h2>

                <p class="text-muted mb-4">
                    Giriş yaptığınız kullanıcı rolü bu sayfayı görüntülemeye yetkili değildir.
                </p>

                @if (User.IsInRole("Vatandas"))
                {
                    <a asp-controller="Vatandas"
                       asp-action="Index"
                       class="btn btn-primary">
                        <i class="bi bi-house-door me-2"></i>
                        Vatandaş Portalına Dön
                    </a>
                }
                else
                {
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-primary">
                        <i class="bi bi-house-door me-2"></i>s
                        Yönetim Paneline Dön
                    </a>
                }

            </div>

        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
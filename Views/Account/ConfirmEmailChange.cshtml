@model KayipEsyaOtomasyonu.ViewModels.ConfirmEmailViewModel
@{
    ViewData["Title"] = "E-posta Değiştirme Doğrulaması";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>E-posta Adresiniz Güncellendi mi? - Kayıp Eşya Sistemi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="bg-light">

    <main class="min-vh-100 d-flex align-items-center justify-content-center px-3 py-5">
        <div class="card border-0 shadow-lg rounded-5 overflow-hidden" style="max-width:560px;width:100%;">

            <div class="p-4 p-md-5 text-white"
                 style="background:linear-gradient(135deg,#7c3aed 0%,#2563eb 60%,#0891b2 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-4 bg-white bg-opacity-15 d-flex align-items-center justify-content-center"
                         style="width:58px;height:58px;font-size:30px;">
                        @if (Model.BasariliMi)
                        {
                            <i class="bi bi-envelope-check-fill"></i>
                        }
                        else
                        {
                            <i class="bi bi-envelope-exclamation-fill"></i>
                        }
                    </div>
                    <div>
                        <div class="fw-bold fs-4 mb-1">
                            @(Model.BasariliMi ? "E-posta Adresiniz Güncellendi!" : "E-posta Değiştirilemedi")
                        </div>
                        <div class="opacity-90 small">Kayıp Eşya Yönetim Sistemi</div>
                    </div>
                </div>
            </div>

            <div class="card-body p-4 p-md-5">

                <div class="mb-4 @(Model.BasariliMi ? "alert alert-success border-0" : "alert alert-danger border-0") rounded-4 d-flex gap-2 align-items-start"
                     style="border-left:5px solid @(Model.BasariliMi ? "#16a34a" : "#dc2626"); margin-bottom:24px;">
                    <i class="@(Model.BasariliMi ? "bi bi-check-circle-fill" : "bi bi-x-circle-fill") fs-4 flex-shrink-0 mt-1"></i>
                    <div>
                        <div class="fw-semibold mb-1">
                            @Html.Raw(Model.Mesaj)
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.HataDetayi))
                        {
                            <div class="small text-muted mt-2">
                                <i class="bi bi-info-circle me-1"></i>
                                Detay: @Model.HataDetayi
                            </div>
                        }
                    </div>
                </div>

                @if (Model.BasariliMi)
                {
                    <div class="alert alert-info border-0 rounded-4 mb-4 small d-flex gap-2 align-items-start"
                         style="border-left:5px solid #0284c7;">
                        <i class="bi bi-lightbulb text-info-emphasis flex-shrink-0 mt-1"></i>
                        <div>
                            Bundan sonra sisteme <strong>YENİ</strong> e-posta adresinizle giriş yapmanız gerekecektir.
                            Şifreniz değişmemiştir. Giriş yaptıktan sonra <strong>Profilim</strong> ekranından yeni e-postanızı doğrulayabilirsiniz.
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning border-0 rounded-4 mb-4 small d-flex gap-2 align-items-start"
                         style="border-left:5px solid #f59e0b;">
                        <i class="bi bi-exclamation-triangle text-warning-emphasis flex-shrink-0 mt-1"></i>
                        <div>
                            <div class="fw-semibold text-warning-emphasis">Öneriler:</div>
                            <ul class="mb-0 mt-1 ps-3">
                                <li>Bağlantıyı tam olarak tıklayın (kopyalarken kesmeyin).</li>
                                <li>Bağlantı süresi (24 saat) dolmuş olabilir; tekrar talep edin.</li>
                                <li>Yeni e-posta farklı bir hesapla eşleşmiş olabilir.</li>
                                <li>Sorun sürerse yöneticiyle iletişime geçin.</li>
                            </ul>
                        </div>
                    </div>
                }

                <hr class="my-4" />

                <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
                    <div class="small text-muted">
                        <i class="bi bi-question-circle me-1"></i>
                        Yardıma mı ihtiyacınız var? Sistem yöneticisiyle iletişime geçin.
                    </div>

                    <a href="@(string.IsNullOrWhiteSpace(Model.DonusLinki) ? "~/Account/Login" : Model.DonusLinki)"
                       class="btn @(Model.BasariliMi ? "btn-primary" : "btn-outline-primary") rounded-4 px-4 fw-semibold shadow-sm">
                        @if (Model.BasariliMi)
                        {
                            <text>
                                <i class="bi bi-person-circle me-1"></i>
                                Profilim / Giriş Ekranına Git
                            </text>
                        }
                        else
                        {
                            <text>
                                <i class="bi bi-arrow-clockwise me-1"></i>
                                Tekrar E-posta Değiştirme Talebi Oluştur
                            </text>
                        }
                    </a>
                </div>

            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

@model KayipEsyaOtomasyonu.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Şifre Sıfırla";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Yeni Şifre Belirle - Kayıp Eşya Sistemi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <style>
        body {
            background:
                radial-gradient(1000px 600px at 90% -10%, rgba(245,158,11,.22), transparent 55%),
                radial-gradient(800px 400px at -10% 110%, rgba(11,92,255,.22), transparent 60%),
                linear-gradient(135deg,#fffbeb 0%,#eff6ff 100%);
            background-attachment: fixed;
        }
    </style>
</head>
<body>

    <main class="min-vh-100 d-flex align-items-center justify-content-center px-3 py-5">
        <div class="card border-0 shadow-lg rounded-5 overflow-hidden" style="max-width:560px;width:100%;">

            <div class="p-4 p-md-5 text-white"
                 style="background:linear-gradient(135deg,#f59e0b 0%,#ef4444 40%,#0b5cff 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-4 bg-white bg-opacity-15 d-flex align-items-center justify-content-center"
                         style="width:58px;height:58px;font-size:30px;">
                        <i class="bi bi-asterisk"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-4 mb-1">Yeni Şifrenizi Belirleyin</div>
                        <div class="opacity-90 small">Kayıp Eşya Yönetim Sistemi</div>
                    </div>
                </div>
            </div>

            <div class="card-body p-4 p-md-5">

                <div class="mb-4 small text-muted">
                    <i class="bi bi-shield-lock me-1 text-warning"></i>
                    Güvende olmak için güçlü bir şifre seçin. Şifreniz 6+ karakter, büyük + küçük harf ve rakam içermelidir.
                </div>

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger rounded-4 border-0 mb-4 d-flex gap-2 align-items-start"
                     style="border-left:5px solid #dc2626;">
                    <i class="bi bi-x-circle-fill flex-shrink-0 mt-1"></i>
                    <span></span>
                </div>

                <form asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>

                    <input type="hidden" asp-for="Token" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">
                            <i class="bi bi-envelope-fill me-1 text-primary"></i>
                            E-posta Adresi
                        </label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text rounded-start-3 border border-secondary-subtle">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input asp-for="Email"
                                   type="email"
                                   class="form-control rounded-end-3 border border-secondary-subtle border-start-0 bg-light"
                                   readonly />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="YeniSifre" class="form-label fw-semibold">
                                <i class="bi bi-key-fill me-1 text-primary"></i>
                                Yeni Şifre *
                            </label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text rounded-start-3 border border-secondary-subtle">
                                    <i class="bi bi-key"></i>
                                </span>
                                <input asp-for="YeniSifre"
                                       id="YeniSifre"
                                       type="password"
                                       class="form-control rounded-end-3 border border-secondary-subtle border-start-0"
                                       placeholder="En az 6 karakter"
                                       autocomplete="new-password" />
                                <button type="button"
                                        onclick="TogglePass('YeniSifre','YeniSifreIcon')"
                                        class="btn btn-outline-secondary border border-secondary-subtle border-start-0 rounded-end-3"
                                        style="border-left:0 !important;"
                                        tabindex="-1">
                                    <i class="bi bi-eye" id="YeniSifreIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="YeniSifre" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="YeniSifreTekrar" class="form-label fw-semibold">
                                <i class="bi bi-key-fill me-1 text-primary"></i>
                                Tekrar *
                            </label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text rounded-start-3 border border-secondary-subtle">
                                    <i class="bi bi-key"></i>
                                </span>
                                <input asp-for="YeniSifreTekrar"
                                       id="YeniSifreTekrar"
                                       type="password"
                                       class="form-control rounded-end-3 border border-secondary-subtle border-start-0"
                                       placeholder="Tekrar yazın"
                                       autocomplete="new-password" />
                                <button type="button"
                                        onclick="TogglePass('YeniSifreTekrar','YeniSifreTekrarIcon')"
                                        class="btn btn-outline-secondary border border-secondary-subtle border-start-0 rounded-end-3"
                                        style="border-left:0 !important;"
                                        tabindex="-1">
                                    <i class="bi bi-eye" id="YeniSifreTekrarIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="YeniSifreTekrar" class="text-danger small d-block mt-1"></span>
                        </div>
                    </div>

                    <div class="alert alert-warning border-0 rounded-4 my-4 d-flex gap-2 align-items-start small"
                         style="border-left:5px solid #f59e0b;">
                        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1 text-warning-emphasis"></i>
                        <div>
                            <strong class="text-warning-emphasis">Şifre Kuralları:</strong>
                            En az 6 karakter, <strong>büyük harf</strong>, <strong>küçük harf</strong> ve <strong>rakam</strong> içermelidir.
                        </div>
                    </div>

                    <button type="submit"
                            class="btn btn-lg w-100 text-white rounded-4 shadow-sm fw-semibold"
                            style="background:linear-gradient(135deg,#f59e0b 0%,#ef4444 60%,#0b5cff 100%);border:0;">
                        <i class="bi bi-floppy-fill me-2"></i>
                        Yeni Şifreyi Kaydet ve Girişe Döndür
                    </button>

                </form>

                <hr class="my-4" />

                <div class="d-flex flex-wrap justify-content-between gap-3 align-items-center">
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-outline-secondary rounded-4 px-4 fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i>
                        Girişe Dön
                    </a>
                    <a asp-controller="Account"
                       asp-action="ForgotPassword"
                       class="btn btn-link fw-semibold">
                        Link süresi doldu / geçersiz mi? Yeniden al
                        <i class="bi bi-arrow-counterclockwise ms-1"></i>
                    </a>
                </div>

            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function TogglePass(inputId, iconId) {
            var el = document.getElementById(inputId);
            var ic = document.getElementById(iconId);
            if (!el) return;
            if (el.type === 'password') {
                el.type = 'text';
                ic.classList.remove('bi-eye');
                ic.classList.add('bi-eye-slash');
            } else {
                el.type = 'password';
                ic.classList.remove('bi-eye-slash');
                ic.classList.add('bi-eye');
            }
        }
    </script>
</body>
</html>

@model KayipEsyaOtomasyonu.ViewModels.ConfirmEmailViewModel
@{
    ViewData["Title"] = "E-posta Doğrulama";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>E-posta Doğrulama - Kayıp Eşya Sistemi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="bg-light">

    <main class="min-vh-100 d-flex align-items-center justify-content-center px-3 py-5">
        <div class="card border-0 shadow-lg rounded-5 overflow-hidden" style="max-width:560px;width:100%;">

            <div class="p-4 p-md-5 text-white"
                 style="background:linear-gradient(135deg,#0b5cff 0%,#10b981 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-4 bg-white bg-opacity-15 d-flex align-items-center justify-content-center"
                         style="width:58px;height:58px;font-size:30px;">
                        @if (Model.BasariliMi)
                        {
                            <i class="bi bi-check-circle-fill"></i>
                        }
                        else
                        {
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        }
                    </div>
                    <div>
                        <div class="fw-bold fs-4 mb-1">
                            @(Model.BasariliMi ? "Doğrulama Başarılı!" : "Doğrulama Başarısız")
                        </div>
                        <div class="opacity-90 small">Kayıp Eşya Yönetim Sistemi</div>
                    </div>
                </div>
            </div>

            <div class="card-body p-4 p-md-5">

                <div class="mb-4 @(Model.BasariliMi ? "alert alert-success border-0" : "alert alert-danger border-0") rounded-4 d-flex gap-2 align-items-start"
                     style="border-left:5px solid @(Model.BasariliMi ? "#16a34a" : "#dc2626"); margin-bottom:24px;">
                    <i class="@(Model.BasariliMi ? "bi bi-check-circle-fill" : "bi bi-x-circle-fill") fs-4 flex-shrink-0 mt-1"></i>
                    <div>
                        <div class="fw-semibold mb-1">
                            @Model.Mesaj
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.HataDetayi))
                        {
                            <div class="small text-muted mt-2">
                                <i class="bi bi-info-circle me-1"></i>
                                Detay: @Model.HataDetayi
                            </div>
                        }
                    </div>
                </div>

                <ul class="list-group list-group-flush small rounded-4 border border-secondary-subtle mb-4 overflow-hidden">
                    <li class="list-group-item px-3 py-2 d-flex gap-2 align-items-center">
                        <i class="bi bi-shield-check text-success me-1"></i>
                        <span>Token doğrulaması <strong>@(Model.BasariliMi ? "BAŞARILI" : "BAŞARISIZ")</strong></span>
                    </li>
                    <li class="list-group-item px-3 py-2 d-flex gap-2 align-items-center">
                        <i class="bi bi-envelope text-primary me-1"></i>
                        <span>E-postanız artık <strong>@(Model.BasariliMi ? "doğrulanmış durumda" : "doğrulanmamış durumda")</strong></span>
                    </li>
                </ul>

                <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center pt-3">

                    <div class="small text-muted">
                        <i class="bi bi-clock-history me-1"></i>
                        Linkiniz süresi dolmuşsa lütfen tekrar talep edin.
                    </div>

                    <a asp-controller="Account"
                       asp-action="@(Model.BasariliMi ? "Login" : "ResendConfirmEmail")"
                       class="btn @(Model.BasariliMi ? "btn-primary" : "btn-outline-primary") rounded-4 px-4 fw-semibold shadow-sm">
                        @if (Model.BasariliMi)
                        {
                            <text>
                                <i class="bi bi-box-arrow-in-right me-1"></i>
                                Giriş Ekranına Git
                            </text>
                        }
                        else
                        {
                            <text>
                                <i class="bi bi-send-plus me-1"></i>
                                Doğrulama E-postasını Tekrar Gönder
                            </text>
                        }
                    </a>
                </div>

                @if (!Model.BasariliMi)
                {
                    <hr class="my-4" />
                    <div class="small text-muted">
                        <div class="fw-semibold mb-2 text-dark"><i class="bi bi-lightbulb text-warning me-1"></i>Öneriler:</div>
                        <ul class="mb-0">
                            <li>Linki kopyalarken sonunu kesmeyin, <strong>tam olarak</strong> tıklayın.</li>
                            <li>Linkin süresi 24 saat olabilir, dolmuşsa tekrar talep edin.</li>
                            <li>Spam / istenmeyen / reklam klasörlerini kontrol edin.</li>
                        </ul>
                    </div>
                }

            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

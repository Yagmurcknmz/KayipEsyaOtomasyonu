@model KayipEsyaOtomasyonu.ViewModels.PersonelEkleViewModel

@{
    ViewData["Title"] = "Yeni Personel Ekle";
}

<div class="row justify-content-center">
    <div class="col-xl-9 col-lg-10">

        <div class="card">

            <div class="card-header">
                <div>
                    <h4 class="mb-1">Yeni Personel Hesabı</h4>
                    <small class="text-muted">
                        Belediye personeline ait kullanıcı hesabını oluşturun.
                    </small>
                </div>
            </div>

            <div class="card-body">

                <form asp-controller="Kullanici"
                      asp-action="PersonelEkle"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="Ad"
                                   class="form-label">
                            </label>

                            <input asp-for="Ad"
                                   class="form-control"
                                   placeholder="Personelin adı" />

                            <span asp-validation-for="Ad"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Soyad"
                                   class="form-label">
                            </label>

                            <input asp-for="Soyad"
                                   class="form-control"
                                   placeholder="Personelin soyadı" />

                            <span asp-validation-for="Soyad"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email"
                                   class="form-label">
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="ornek@arnavutkoy.bel.tr"
                                   autocomplete="off" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SicilNo"
                                   class="form-label">
                            </label>

                            <input asp-for="SicilNo"
                                   class="form-control"
                                   placeholder="Örneğin: 10245" />

                            <span asp-validation-for="SicilNo"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Birim"
                                   class="form-label">
                            </label>

                            <select asp-for="Birim"
                                    class="form-select">
                                <option value="">Birim seçiniz</option>
                                <option>Bilgi İşlem Müdürlüğü</option>
                                <option>Zabıta Müdürlüğü</option>
                                <option>Destek Hizmetleri Müdürlüğü</option>
                                <option>Fen İşleri Müdürlüğü</option>
                                <option>Kültür ve Sosyal İşler Müdürlüğü</option>
                                <option>Sosyal Yardım İşleri Müdürlüğü</option>
                                <option>Yazı İşleri Müdürlüğü</option>
                            </select>

                            <span asp-validation-for="Birim"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Sifre"
                                   class="form-label">
                            </label>

                            <input asp-for="Sifre"
                                   class="form-control"
                                   placeholder="En az 6 karakter"
                                   autocomplete="new-password" />

                            <span asp-validation-for="Sifre"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SifreTekrar"
                                   class="form-label">
                            </label>

                            <input asp-for="SifreTekrar"
                                   class="form-control"
                                   placeholder="Şifreyi tekrar giriniz"
                                   autocomplete="new-password" />

                            <span asp-validation-for="SifreTekrar"
                                  class="text-danger">
                            </span>
                        </div>

                    </div>

                    <div class="alert alert-info mt-4 mb-0">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        Oluşturulan kullanıcıya otomatik olarak
                        <strong>Personel</strong> rolü verilecektir.
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">

                        <a asp-controller="Kullanici"
                           asp-action="Index"
                           class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-2"></i>
                            Geri Dön
                        </a>

                        <button type="submit"
                                class="btn btn-primary">
                            <i class="bi bi-person-plus-fill me-2"></i>
                            Personeli Kaydet
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
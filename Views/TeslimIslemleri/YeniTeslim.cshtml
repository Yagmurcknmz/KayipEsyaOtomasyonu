@model TeslimIslemi
@{
    ViewData["Title"] = "Yeni Teslim Kaydı";
    var eslesmeListesi = ViewBag.OnaylanmisEslesmeler as System.Collections.IEnumerable ??
                         System.Linq.Enumerable.Empty<object>();
    var eslesmeList = eslesmeListesi.Cast<dynamic>().ToList();
}

<section class="container-fluid p-4">

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-0">
                <i class="bi bi-box-arrow-up text-success me-2"></i>
                Yeni Teslim Kaydı
            </h4>
            <small class="text-muted">Onaylanmış eşleşmeler için teslim tutanağı oluşturun</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-arrow-left me-1"></i>Listeye Dön
        </a>
    </div>

    <form asp-action="YeniTeslim" method="post" class="row g-3">
        <div asp-validation-summary="ModelOnly"
             class="col-12 alert alert-danger rounded-4 border-0 shadow-sm mb-0"></div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-link-45deg me-1 text-primary"></i>
                        Eşleşme Seçimi
                        @if (!eslesmeList.Any())
                        {
                            <small class="text-danger ms-2">
                                ⚠️ Onaylanmış ve teslim edilmemiş hiç eşleşme yok!
                            </small>
                        }
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Eşleşme <span class="text-danger">*</span>
                        </label>
                        <select asp-for="EslesmeId"
                                id="eslesmeSelect"
                                class="form-select form-select-lg rounded-3 @(!eslesmeList.Any() ? "border-danger" : "")"
                                size="6"
                                required>
                            @if (!eslesmeList.Any())
                            {
                                <option value="">❌ Onaylanmış bekleyen eşleşme yok</option>
                            }
                            else
                            {
                                <option value="">-- Lütfen bir eşleşme seçin --</option>
                                @foreach (var e in eslesmeList)
                                {
                                    <option value="@e.Id"
                                            selected="@(Model.EslesmeId == e.Id ? "selected" : null)">
                                        @e.Baslik
                                    </option>
                                }
                            }
                        </select>
                        <span asp-validation-for="EslesmeId" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mt-3">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-people me-1 text-success"></i>
                        Teslim Alan Kişi Bilgileri
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">
                                Ad Soyad <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input asp-for="TeslimAlanKisi"
                                       class="form-control rounded-end-3"
                                       placeholder="Ad Soyad"
                                       required />
                            </div>
                            <span asp-validation-for="TeslimAlanKisi" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">
                                TC Kimlik No
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-card-text"></i></span>
                                <input asp-for="TcKimlikNo"
                                       class="form-control rounded-end-3"
                                       maxlength="11"
                                       placeholder="11 haneli" />
                            </div>
                            <span asp-validation-for="TcKimlikNo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">İletişim Telefonu</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                <input asp-for="IletisimTelefonu"
                                       class="form-control rounded-end-3"
                                       maxlength="20"
                                       placeholder="05XX XXX XX XX" />
                            </div>
                            <span asp-validation-for="IletisimTelefonu" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Teslim Eden Personel
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                                <input type="text"
                                       value="@ViewBag.TeslimEdenAdSoyad"
                                       class="form-control rounded-end-3 bg-light"
                                       readonly />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mt-3">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-calendar-check me-1 text-warning"></i>
                        Tarih, Yer ve Şekil
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Teslim Tarihi *</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
                                <input asp-for="TeslimTarihi"
                                       type="date"
                                       class="form-control rounded-end-3"
                                       required />
                            </div>
                            <span asp-validation-for="TeslimTarihi" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Teslim Saati</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-clock"></i></span>
                                <input asp-for="TeslimSaati"
                                       type="time"
                                       class="form-control rounded-end-3" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Teslim Şekli</label>
                            <select asp-for="TeslimSekli" class="form-select rounded-3">
                                <option value="Şahsen">Şahsen</option>
                                <option value="Posta / Kargo">Posta / Kargo</option>
                                <option value="Elçi">Elçi ile</option>
                                <option value="Diğer">Diğer</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Teslim Yeri *</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                                <input asp-for="TeslimYeri"
                                       class="form-control rounded-end-3"
                                       required />
                            </div>
                            <span asp-validation-for="TeslimYeri" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Ek Notlar</label>
                            <textarea asp-for="EkNotlar"
                                      class="form-control rounded-3"
                                      rows="3"
                                      maxlength="500"
                                      placeholder="Varsa ek notları buraya yazın..."></textarea>
                            <div class="text-end small text-muted mt-1">
                                @((Model.EkNotlar ?? "").Length) / 500
                            </div>
                            <span asp-validation-for="EkNotlar" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-3 sticky-top"
                 style="top:20px;">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-shield-check me-1 text-success"></i>
                        Onay
                    </h5>
                </div>
                <div class="card-body">
                    <div class="form-check form-switch d-flex align-items-center gap-2 p-3 mb-3 bg-light-subtle rounded-3">
                        <input asp-for="ImzaOnayi"
                               class="form-check-input flex-shrink-0"
                               type="checkbox"
                               role="switch"
                               id="imzaOn" />
                        <div class="flex-grow-1">
                            <label class="form-check-label fw-semibold mb-0" for="imzaOn">
                                <i class="bi bi-pen text-success me-1"></i>
                                İmza Alındı
                            </label>
                            <div class="small text-muted mt-1">
                                Teslim alan kişiden imza alındıysa işaretleyin
                            </div>
                        </div>
                    </div>
                    <div class="alert alert-warning rounded-3 border-0 mb-3 small" role="alert">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Bu form gönderildiğinde:
                        <ul class="mb-0 mt-1 ps-3">
                            <li>Eşleşme "Teslim Edildi" olur</li>
                            <li>Kayıp eşya ve başvuru durumu güncellenir</li>
                            <li>Vatandaşa otomatik bildirim gönderilir</li>
                        </ul>
                    </div>
                    <div class="d-grid gap-2">
                        <a asp-action="Index"
                           class="btn btn-outline-secondary rounded-4">
                            <i class="bi bi-x-circle me-1"></i>
                            İptal
                        </a>
                        <button type="submit"
                                class="btn btn-success btn-lg rounded-4"
                                @((!eslesmeList.Any()) ? "disabled" : null)>
                            <i class="bi bi-check-circle me-1"></i>
                            Teslimi Kaydet ve Bildirim Gönder
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

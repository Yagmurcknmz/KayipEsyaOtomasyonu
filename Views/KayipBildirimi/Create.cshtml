    .resim-kart:hover {
        transform: translateY(-3px) scale(1.035);
        box-shadow: 0 12px 24px -8px rgba(15,23,42,0.18) !important;
        z-index: 2;
    }
    .resim-sil-btn { transition: transform .15s ease, filter .15s ease; }
    .resim-sil-btn:hover { transform: scale(1.15); filter: brightness(1.1); }
    .leaflet-container { font-family: inherit; }
    .leaflet-popup-content-wrapper { border-radius: 14px; box-shadow: 0 10px 25px rgba(0,0,0,.12); }
</style>


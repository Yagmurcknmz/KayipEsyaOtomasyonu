@model KayipEsyaOtomasyonu.ViewModels.KayipBildirimiOlusturViewModel

@{
    ViewData["Title"] = "Yeni Kayıp Bildirimi";
    Layout = "~/Views/Shared/_VatandasLayout.cshtml";
}

<section class="p-4" style="min-height:calc(100vh - 140px);">

    <div class="mb-4">
        <div class="card border-0 rounded-5 overflow-hidden shadow-sm text-white hero-gradient"
             style="background: radial-gradient(circle at top right, rgba(255,255,255,.2), transparent 45%),
                    linear-gradient(135deg,#16a34a 0%,#15803d 45%,#065f46 100%);">
            <div class="card-body p-4 p-md-5">
                <div class="row align-items-center g-4">
                    <div class="col-md-8">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-circle hero-avatar-solid text-success d-flex align-items-center justify-content-center"
                                 style="width:60px;height:60px;">
                                <i class="bi bi-megaphone-fill fs-2"></i>
                            </div>
                            <div>
                                <h2 class="fw-bold mb-1 lh-sm">Yeni Kayıp Bildirimi</h2>
                                <div class="small opacity-90">
                                    Kaybettiğiniz eşyayı hızlıca bildirin — size dönmesi için ilk adım.
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-3 mt-3">
                            <div class="badge hero-badge-solid rounded-pill px-3 py-2">
                                <i class="bi bi-check-circle me-1 text-success"></i>3 adımda tamamlanır
                            </div>
                            <div class="badge hero-badge-solid rounded-pill px-3 py-2">
                                <i class="bi bi-shield-check me-1 text-success"></i>Güvenli & Ücretsiz
                            </div>
                            <div class="badge hero-badge-solid rounded-pill px-3 py-2">
                                <i class="bi bi-bell me-1 text-success"></i>Anında bildirim alırsınız
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 text-end d-none d-md-block">
                        <i class="bi bi-search-heart" style="font-size:120px;opacity:.18;"></i>
                    </div>
                </div>

                <div class="row g-3 mt-4">
                    <div class="col-md-4">
                        <div class="d-flex align-items-center gap-2 p-3 bg-white rounded-4 border shadow-sm">
                            <span class="rounded-circle text-white fw-bold d-inline-flex align-items-center justify-content-center shadow-sm"
                                  style="width:34px;height:34px;background:linear-gradient(135deg,#16a34a,#047857);">1</span>
                            <div>
                                <div class="fw-semibold" style="color:#0f172a;">Eşya Bilgileri</div>
                                <div class="small" style="color:#475569;">Ad, kategori, renk</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex align-items-center gap-2 p-3 bg-white rounded-4 border shadow-sm">
                            <span class="rounded-circle text-white fw-bold d-inline-flex align-items-center justify-content-center shadow-sm"
                                  style="width:34px;height:34px;background:linear-gradient(135deg,#16a34a,#047857);">2</span>
                            <div>
                                <div class="fw-semibold" style="color:#0f172a;">Kayıp Detayları</div>
                                <div class="small" style="color:#475569;">Tarih, yer, marka</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex align-items-center gap-2 p-3 bg-white rounded-4 border shadow-sm">
                            <span class="rounded-circle text-white fw-bold d-inline-flex align-items-center justify-content-center shadow-sm"
                                  style="width:34px;height:34px;background:linear-gradient(135deg,#16a34a,#047857);">3</span>
                            <div>
                                <div class="fw-semibold" style="color:#0f172a;">Açıklama & Gönder</div>
                                <div class="small" style="color:#475569;">Özellikler & onay</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-4 p-md-5">

            <form asp-controller="KayipBildirimi"
                  asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger rounded-4 border-0 mb-4"
                     style="border-left:5px solid #dc2626;">
                </div>

                <div class="mb-4 pb-3 border-bottom">
                    <h5 class="fw-bold mb-1">
                        <span class="me-2 badge bg-success-subtle text-success-emphasis rounded-pill px-3 py-1">Adım 1</span>
                        Eşya Hakkında Temel Bilgiler
                    </h5>
                    <small class="text-muted">Eşyanızı kolayca tanımak için gerekli bilgiler.</small>
                </div>

                <div class="row g-4 mb-5">
                    <div class="col-md-6">
                        <label asp-for="EsyaAdi" class="form-label fw-semibold">Eşya Adı *</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text"><i class="bi bi-box-seam"></i></span>
                            <input asp-for="EsyaAdi"
                                   class="form-control rounded-end-3"
                                   placeholder="Örneğin: Siyah cep telefonu" />
                        </div>
                        <span asp-validation-for="EsyaAdi" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="KategoriId" class="form-label fw-semibold">Kategori *</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text"><i class="bi bi-list-task"></i></span>
                            <select asp-for="KategoriId"
                                    asp-items="ViewBag.Kategoriler"
                                    class="form-select rounded-end-3">
                                <option value="">— Kategori Seçiniz —</option>
                            </select>
                        </div>
                        <small class="text-muted">
                            <i class="bi bi-info-circle me-1 text-info"></i>
                            Uygun kategoriyi seçin, eşleşmeyi hızlandırır.
                        </small>
                        <span asp-validation-for="KategoriId" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Marka" class="form-label fw-semibold">Marka</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text"><i class="bi bi-tag"></i></span>
                            <input asp-for="Marka"
                                   class="form-control rounded-end-3"
                                   placeholder="Örneğin: Samsung" />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Model" class="form-label fw-semibold">Model</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                            <input asp-for="Model"
                                   class="form-control rounded-end-3"
                                   placeholder="Örneğin: Galaxy S24" />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Renk" class="form-label fw-semibold">Renk</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text"><i class="bi bi-palette"></i></span>
                            <input asp-for="Renk"
                                   class="form-control rounded-end-3"
                                   placeholder="Örneğin: Siyah" />
                        </div>
                    </div>
                </div>

                <div class="mb-4 pb-3 border-bottom">
                    <h5 class="fw-bold mb-1">
                        <span class="me-2 badge bg-primary-subtle text-primary-emphasis rounded-pill px-3 py-1">Adım 2</span>
                        Kayıp Detayları
                    </h5>
                    <small class="text-muted">Ne zaman ve nerede kaybettiğiniz bilgisi eşleşmeyi sağlar.</small>
                </div>

                <div class="row g-4 mb-5">
                    <div class="col-md-6">
                        <label asp-for="KayipTarihi" class="form-label fw-semibold">Kayıp Tarihi *</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                            <input asp-for="KayipTarihi"
                                   type="date"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   class="form-control rounded-end-3" />
                        </div>
                        <span asp-validation-for="KayipTarihi" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="KayipYeri" class="form-label fw-semibold">Kayıp Yeri *</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text"><i class="bi bi-geo-alt-fill"></i></span>
                            <input asp-for="KayipYeri"
                                   class="form-control rounded-end-3"
                                   placeholder="Örneğin: Arnavutköy Meydanı, Otobüs Durağı" />
                        </div>
                        <span asp-validation-for="KayipYeri" class="text-danger small d-block mt-1"></span>
                    </div>
                </div>

                <div class="mb-4 pb-3 border-bottom">
                    <h5 class="fw-bold mb-1">
                        <span class="me-2 badge bg-warning-subtle text-warning-emphasis rounded-pill px-3 py-1">Adım 3</span>
                        Açıklama & Ayırt Edici Özellikler
                    </h5>
                    <small class="text-muted">Eşyayı sizin olduğunuzu ispatlayacak detaylar yazın.</small>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-12">
                        <label asp-for="AyirtEdiciOzellik" class="form-label fw-semibold">Ayırt Edici Özellikler</label>
                        <div class="card border border-secondary-subtle rounded-4 overflow-hidden">
                            <div class="card-header bg-white border-bottom px-3 py-2 d-flex align-items-center gap-2">
                                <i class="bi bi-star-fill text-warning"></i>
                                <small class="fw-semibold">Çizik, leke, özel kılıf, numara yazısı vb.</small>
                            </div>
                            <textarea asp-for="AyirtEdiciOzellik"
                                      rows="3"
                                      class="form-control border-0 rounded-0 p-3"
                                      style="min-height:120px;"
                                      placeholder="Örneğin: Ekranın sol alt köşesinde çatlak var, arka kapağında pembe kılıf, içine 5 TL kağıt konmuş..."></textarea>
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Aciklama" class="form-label fw-semibold">Ek Açıklama</label>
                        <div class="card border border-secondary-subtle rounded-4 overflow-hidden">
                            <div class="card-header bg-white border-bottom px-3 py-2 d-flex align-items-center gap-2">
                                <i class="bi bi-chat-left-text text-info"></i>
                                <small class="fw-semibold">Durum, iletişim veya diğer bilgiler</small>
                            </div>
                            <textarea asp-for="Aciklama"
                                      rows="4"
                                      class="form-control border-0 rounded-0 p-3"
                                      style="min-height:140px;"
                                      placeholder="Kayboluş şekli, içinde başka eşyalar olup olmadığı, iletişime geçmek istediğiniz özel bir not..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 p-4 rounded-4 bg-light">
                    <div class="small text-muted d-flex align-items-center gap-2">
                        <i class="bi bi-shield-lock text-primary fs-4"></i>
                        <div>
                            <div class="fw-semibold text-dark">Bilgileriniz güvende</div>
                            <div>Bu bilgiler sadece eşyayı size iade etmek amacıyla kullanılır.</div>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-controller="Vatandas"
                           asp-action="Index"
                           class="btn btn-lg btn-outline-secondary rounded-4 px-4">
                            <i class="bi bi-arrow-left me-1"></i>
                            Vazgeç
                        </a>
                        <button type="submit"
                                class="btn btn-lg rounded-4 px-5 text-white shadow-sm transition-hover"
                                style="background: linear-gradient(135deg,#16a34a,#047857);border:0;">
                            <i class="bi bi-send-fill me-2"></i>
                            Başvuruyu Gönder
                        </button>
                    </div>
                </div>

            </form>
        </div>
    </div>

</section>

<style>
    .transition-hover {
        transition: transform .2s ease, box-shadow .2s ease, filter .2s ease;
    }

    .transition-hover:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 20px -8px rgba(22, 163, 74, .35) !important;
        filter: brightness(1.05);
    }

    .input-group-text {
        background: #f8fafc !important;
        border-right: 0 !important;
    }

    .form-control, .form-select {
        border-left: 0 !important;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

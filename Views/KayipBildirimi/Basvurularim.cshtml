@model IEnumerable<KayipEsyaOtomasyonu.Models.KayipBildirimi>

@{
    ViewData["Title"] = "Başvurularım";
    Layout = "~/Views/Shared/_VatandasLayout.cshtml";
}

<div class="dashboard-header mb-4">
    <div>
        <h2>Başvurularım</h2>
        <p class="text-muted mb-0">
            Kayıp eşya başvurularınızı ve güncel durumlarını takip edin.
        </p>
    </div>

    <a asp-controller="KayipBildirimi"
       asp-action="Create"
       class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>
        Yeni Başvuru
    </a>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-1">Kayıp Bildirimlerim</h5>
        <small class="text-muted">
            Toplam @Model.Count() başvuru bulunuyor.
        </small>
    </div>

    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="bi bi-clipboard-x"></i>
                </div>

                <h5>Henüz başvurunuz yok</h5>

                <p>
                    Kaybettiğiniz eşya için yeni bir bildirim oluşturabilirsiniz.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Başvuru No</th>
                            <th>Eşya</th>
                            <th>Kategori</th>
                            <th>Kayıp Tarihi</th>
                            <th>Kayıp Yeri</th>
                            <th>Durum</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var basvuru in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@basvuru.BasvuruNo</strong>
                                </td>

                                <td>@basvuru.EsyaAdi</td>

                                <td>
                                    @(basvuru.Kategori?.Ad ?? "-")
                                </td>

                                <td>
                                    @basvuru.KayipTarihi.ToString("dd.MM.yyyy")
                                </td>

                                <td>@basvuru.KayipYeri</td>

                                <td>
                                    <span class="badge bg-info text-dark">
                                        @basvuru.Durum
                                    </span>
                                </td>

                                <td class="text-end">
                                    <a asp-controller="KayipBildirimi"
                                       asp-action="Details"
                                       asp-route-id="@basvuru.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i>
                                        Detay
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>
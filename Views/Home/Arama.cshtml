@model KayipEsyaOtomasyonu.ViewModels.AramaSonucuViewModel

@{
    ViewData["Title"] = "Arama Sonuçları";
}

<div class="mb-4">
    <div class="card border-0 rounded-4 overflow-hidden shadow-sm text-white hero-gradient"
         style="background:linear-gradient(135deg,#0b5cff 0%,#083bc7 55%,#052a91 100%);">
        <div class="card-body p-4 p-md-5">
            <h2 class="fw-bold mb-1">
                <i class="bi bi-search me-2"></i>Arama Sonuçları
            </h2>
            @if (!string.IsNullOrWhiteSpace(Model.AramaKelimesi))
            {
                <div class="small opacity-90">
                    "<strong>@Model.AramaKelimesi</strong>" için sonuçlar listeleniyor.
                    @((Model.ToplamEsya + Model.ToplamBasvuru + Model.ToplamEslesme + Model.ToplamKullanici)
                        == 0
                        ? "Hiç eşleşme bulunamadı."
                        : $"{(Model.ToplamEsya + Model.ToplamBasvuru + Model.ToplamEslesme + Model.ToplamKullanici)} eşleşme bulundu.")
                </div>
            }
            else
            {
                <div class="small opacity-90">
                    Aramak istediğiniz kelimeyi üstteki arama çubuğundan veya aşağıdan girin.
                </div>
            }
        </div>
    </div>
</div>

<form asp-controller="Home" asp-action="Arama" method="get" class="mb-4">
    <div class="card border-0 rounded-4 shadow-sm">
        <div class="card-body p-3">
            <div class="d-flex gap-2">
                <div class="flex-grow-1">
                    <input name="ara"
                           value="@Model.AramaKelimesi"
                           class="form-control form-control-lg rounded-3"
                           placeholder="Eşya adı, marka, renk, vatandaş adı, kategori ara..." />
                </div>
                <button type="submit"
                        class="btn btn-primary btn-lg rounded-3 px-4">
                    <i class="bi bi-search me-2"></i>Ara
                </button>
            </div>
        </div>
    </div>
</form>

<div class="row g-4 mb-4">
    <div class="col-xl-3 col-lg-6">
        <div class="stat-card">
            <div class="stat-card-icon stat-primary">
                <i class="bi bi-box-seam-fill"></i>
            </div>
            <div class="stat-card-content">
                <span>Bulunan Eşya</span>
                <h3>@Model.ToplamEsya</h3>
                <small>Kayıp Eşya kayıtları</small>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6">
        <div class="stat-card">
            <div class="stat-card-icon" style="background:#fef2f2;color:#b91c1c;">
                <i class="bi bi-clipboard-fill"></i>
            </div>
            <div class="stat-card-content">
                <span>Bulunan Başvuru</span>
                <h3>@Model.ToplamBasvuru</h3>
                <small>Kayıp Bildirimleri</small>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6">
        <div class="stat-card">
            <div class="stat-card-icon stat-info">
                <i class="bi bi-link-45deg"></i>
            </div>
            <div class="stat-card-content">
                <span>Bulunan Eşleşme</span>
                <h3>@Model.ToplamEslesme</h3>
                <small>Eşleşme kayıtları</small>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6">
        <div class="stat-card">
            <div class="stat-card-icon" style="background:#ecfeff;color:#0e7490;">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="stat-card-content">
                <span>Kullanıcılar</span>
                <h3>@Model.ToplamKullanici</h3>
                <small>@(User.IsInRole("Admin") ? "Admin erişimli" : "Yalnıza Admin arayabilir")</small>
            </div>
        </div>
    </div>
</div>

@if (Model.Esyalar.Any())
{
    <div class="card border-0 rounded-4 shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center border-0 py-3">
            <div>
                <h5 class="mb-1 fw-semibold">
                    <i class="bi bi-box-seam-fill me-2 text-primary"></i>Eşleşen Kayıp Eşyalar
                </h5>
                <small class="text-muted">@Model.ToplamEsya eşya bulundu</small>
            </div>
            <a asp-controller="KayipEsya" asp-action="Index" class="btn btn-sm btn-outline-primary">Tümünü Gör</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0 table-hover">
                    <thead class="bg-light">
                        <tr>
                            <th>Eşya</th><th>Kategori</th><th>Durum</th><th>Tarih</th><th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Esyalar)
                        {
                            <tr>
                                <td><strong>@e.EsyaAdi</strong> @if (!string.IsNullOrWhiteSpace(e.Marka)) { <small class="text-muted">· @e.Marka</small> }</td>
                                <td>@(e.Kategori?.Ad ?? "-")</td>
                                <td>
                                    <span class="badge bg-secondary">@(string.IsNullOrWhiteSpace(e.Durum) ? "-" : e.Durum)</span>
                                </td>
                                <td><small>@e.OlusturmaTarihi.ToString("dd.MM.yyyy")</small></td>
                                <td class="text-end">
                                    <a asp-controller="KayipEsya" asp-action="Details" asp-route-id="@e.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (Model.Basvurular.Any())
{
    <div class="card border-0 rounded-4 shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center border-0 py-3">
            <div>
                <h5 class="mb-1 fw-semibold">
                    <i class="bi bi-clipboard-check-fill me-2" style="color:#b91c1c;"></i>Eşleşen Kayıp Başvuruları
                </h5>
                <small class="text-muted">@Model.ToplamBasvuru başvuru bulundu</small>
            </div>
            <a asp-controller="KayipBasvuru" asp-action="Index" class="btn btn-sm btn-outline-danger">Tümünü Gör</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0 table-hover">
                    <thead class="bg-light">
                        <tr>
                            <th>Eşya</th><th>Kategori</th><th>Vatandaş</th><th>Durum</th><th>Tarih</th><th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.Basvurular)
                        {
                            <tr>
                                <td><strong>@b.EsyaAdi</strong></td>
                                <td>@(b.Kategori?.Ad ?? "-")</td>
                                <td>@(b.Vatandas != null ? b.Vatandas.Ad + " " + b.Vatandas.Soyad : "-")</td>
                                <td>
                                    <span class="badge bg-warning text-dark">@(string.IsNullOrWhiteSpace(b.Durum) ? "Beklemede" : b.Durum)</span>
                                </td>
                                <td><small>@b.BasvuruTarihi.ToString("dd.MM.yyyy")</small></td>
                                <td class="text-end">
                                    <a asp-controller="KayipBildirimi" asp-action="Details" asp-route-id="@b.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (Model.Eslesmeler.Any())
{
    <div class="card border-0 rounded-4 shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center border-0 py-3">
            <div>
                <h5 class="mb-1 fw-semibold">
                    <i class="bi bi-diagram-2 me-2 text-info"></i>Eşleşen Eşleşmeler
                </h5>
                <small class="text-muted">@Model.ToplamEslesme eşleşme bulundu</small>
            </div>
            <a asp-controller="Eslesme" asp-action="Index" class="btn btn-sm btn-outline-info">Tümünü Gör</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0 table-hover">
                    <thead class="bg-light">
                        <tr>
                            <th>Başvuru</th><th>Eşya</th><th>Skor</th><th>Durum</th><th>Tarih</th><th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Eslesmeler)
                        {
                            <tr>
                                <td>@e.KayipBildirimi?.EsyaAdi</td>
                                <td>@e.KayipEsya?.EsyaAdi</td>
                                <td>
                                    <span class="badge @(e.Skor >= 80 ? "bg-success" : e.Skor >= 55 ? "bg-info" : e.Skor >= 35 ? "bg-warning text-dark" : "bg-danger")">
                                        %@e.Skor
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@e.Durum</span>
                                </td>
                                <td><small>@e.OlusturmaTarihi.ToString("dd.MM.yyyy")</small></td>
                                <td class="text-end">
                                    <a asp-controller="Eslesme" asp-action="Details" asp-route-id="@e.Id"
                                       class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (Model.Kullanicilar.Any())
{
    <div class="card border-0 rounded-4 shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center border-0 py-3">
            <div>
                <h5 class="mb-1 fw-semibold">
                    <i class="bi bi-people-fill me-2" style="color:#0e7490;"></i>Bulunan Kullanıcılar
                </h5>
                <small class="text-muted">Sadece admin görünür · @Model.ToplamKullanici kullanıcı bulundu</small>
            </div>
            <a asp-controller="Kullanici" asp-action="Index" class="btn btn-sm btn-outline-secondary">Tümünü Gör</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0 table-hover">
                    <thead class="bg-light">
                        <tr>
                            <th>Ad Soyad</th><th>E-posta</th><th>Kullanıcı Adı</th><th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Kullanicilar)
                        {
                            <tr>
                                <td><strong>@u.Ad @u.Soyad</strong></td>
                                <td>@u.Email</td>
                                <td>@u.UserName</td>
                                <td class="text-end">
                                    <a asp-controller="Kullanici" asp-action="Edit" asp-route-id="@u.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if ((Model.ToplamEsya + Model.ToplamBasvuru + Model.ToplamEslesme + Model.ToplamKullanici) == 0 &&
     !string.IsNullOrWhiteSpace(Model.AramaKelimesi))
{
    <div class="card border-0 rounded-4 shadow-sm">
        <div class="card-body p-5 text-center">
            <div class="mb-3">
                <i class="bi bi-search display-4 text-muted opacity-25"></i>
            </div>
            <h5>Hiç sonuç bulunamadı</h5>
            <p class="text-muted mb-0">
                "<strong>@Model.AramaKelimesi</strong>" için eşleşen kayıt bulunamadı.
                Farklı bir kelime deneyin.
            </p>
        </div>
    </div>
}

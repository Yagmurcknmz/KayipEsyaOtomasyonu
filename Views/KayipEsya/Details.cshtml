@model KayipEsyaOtomasyonu.Models.KayipEsya

@{
    ViewData["Title"] = "Kayıp Eşya Detayı";
}

<div class="row justify-content-center">
    <div class="col-xl-10">

        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-1">@Model.EsyaAdi</h4>
                    <small class="text-muted">
                        Kayıp eşya kayıt detayları
                    </small>
                </div>

                <span class="badge bg-info text-dark">
                    @Model.Durum
                </span>
            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-6">
                        <div class="detail-item">
                            <span class="detail-label">Kategori</span>
                            <strong>@(Model.Kategori?.Ad ?? "-")</strong>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <span class="detail-label">Bulunma Tarihi</span>
                            <strong>@Model.BulunmaTarihi.ToString("dd.MM.yyyy")</strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="detail-item">
                            <span class="detail-label">Marka</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.Marka) ? "-" : Model.Marka)</strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="detail-item">
                            <span class="detail-label">Model</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.Model) ? "-" : Model.Model)</strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="detail-item">
                            <span class="detail-label">Renk</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.Renk) ? "-" : Model.Renk)</strong>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <span class="detail-label">Seri Numarası</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.SeriNo) ? "-" : Model.SeriNo)</strong>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <span class="detail-label">Raf Numarası</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.RafNo) ? "-" : Model.RafNo)</strong>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <span class="detail-label">Bulunma Yeri</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.BulunmaYeri) ? "-" : Model.BulunmaYeri)</strong>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <span class="detail-label">Mahalle</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.Mahalle) ? "-" : Model.Mahalle)</strong>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <span class="detail-label">Birim</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.Birim) ? "-" : Model.Birim)</strong>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <span class="detail-label">Kayıt Tarihi</span>
                            <strong>@Model.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</strong>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="detail-item">
                            <span class="detail-label">Ayırt Edici Özellik</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.AyirtEdiciOzellik)
                                    ? "-"
                                    : Model.AyirtEdiciOzellik)
                            </strong>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="detail-item">
                            <span class="detail-label">Açıklama</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.Aciklama)
                                    ? "-"
                                    : Model.Aciklama)
                            </strong>
                        </div>
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-controller="KayipEsya"
                       asp-action="Index"
                       class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-2"></i>
                        Listeye Dön
                    </a>

                </div>

            </div>

        </div>

    </div>
</div>
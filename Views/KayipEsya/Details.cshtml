@model KayipEsyaOtomasyonu.Models.KayipEsya

@{
    ViewData["Title"] = "Kayıp Eşya Detayı";
}

<div class="row justify-content-center">
    <div class="col-xl-10">

        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-1">@Model.EsyaAdi</h4>
                    <small class="text-muted">
                        Kayıp eşya kayıt detayları
                    </small>
                </div>

                <span class="badge bg-info text-dark">
                    @Model.Durum
                </span>
            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-6">
                        <div class="detail-item">
                            <span class="detail-label">Kategori</span>
                            <strong>@(Model.Kategori?.Ad ?? "-")</strong>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <span class="detail-label">Bulunma Tarihi</span>
                            <strong>@Model.BulunmaTarihi.ToString("dd.MM.yyyy")</strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="detail-item">
                            <span class="detail-label">Marka</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.Marka) ? "-" : Model.Marka)</strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="detail-item">
                            <span class="detail-label">Model</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.Model) ? "-" : Model.Model)</strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="detail-item">
                            <span class="detail-label">Renk</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.Renk) ? "-" : Model.Renk)</strong>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <span class="detail-label">Seri Numarası</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.SeriNo) ? "-" : Model.SeriNo)</strong>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <span class="detail-label">Raf Numarası</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.RafNo) ? "-" : Model.RafNo)</strong>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <span class="detail-label">Bulunma Yeri</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.BulunmaYeri) ? "-" : Model.BulunmaYeri)</strong>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <span class="detail-label">Mahalle</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.Mahalle) ? "-" : Model.Mahalle)</strong>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <span class="detail-label">Birim</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.Birim) ? "-" : Model.Birim)</strong>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <span class="detail-label">Kayıt Tarihi</span>
                            <strong>@Model.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</strong>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="detail-item">
                            <span class="detail-label">Ayırt Edici Özellik</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.AyirtEdiciOzellik)
                                    ? "-"
                                    : Model.AyirtEdiciOzellik)
                            </strong>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="detail-item">
                            <span class="detail-label">Açıklama</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.Aciklama)
                                    ? "-"
                                    : Model.Aciklama)
                            </strong>
                        </div>
                    </div>

                </div>

                @if (Model.Resimler != null && Model.Resimler.Any(r => r.AktifMi))
                {
                    <hr class="my-4" />
                    <h6 class="fw-semibold mb-3 text-danger"><i class="bi bi-images me-2"></i> Eşya Fotoğrafları (@(Model.Resimler.Count(r => r.AktifMi)))  <small class="text-muted fw-normal">— büyümesini istediğinize tıklayın</small></h6>
                    <div class="d-flex flex-wrap gap-3 mb-3">
                        @foreach (var r in Model.Resimler.Where(rr => rr.AktifMi))
                        {
                            <a href="@r.DosyaYolu" target="_blank" class="rounded-3 overflow-hidden border shadow-sm position-relative @(r.VarsayilanResimMi ? "ring-2 ring-primary" : "")" style="width:110px;height:110px;display:block;">
                                <img src="@(string.IsNullOrWhiteSpace(r.ThumbnailYolu) ? r.DosyaYolu : r.ThumbnailYolu)" class="w-100 h-100" style="object-fit:cover;" alt="@Model.EsyaAdi" />
                                @if (r.VarsayilanResimMi)
                                {
                                    <span class="position-absolute top-0 start-0 m-1 badge bg-primary rounded-pill"><i class="bi bi-star-fill me-1"></i>Kapak</span>
                                }
                            </a>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.AdresDetayi) || (Model.Enlem.HasValue && Model.Boylam.HasValue))
                {
                    <hr class="my-4" />
                    <h6 class="fw-semibold mb-3" style="color:#0ea5e9;"><i class="bi bi-geo-alt-fill me-2"></i> Bulunma Yeri</h6>
                    @if (!string.IsNullOrWhiteSpace(Model.AdresDetayi))
                    {
                        <div class="alert alert-info bg-opacity-10 border-info border-opacity-25 rounded-4 mb-3">
                            <i class="bi bi-signpost-2-fill me-2 text-info"></i>
                            <strong class="text-dark">Adres:</strong> @Model.AdresDetayi
                        </div>
                    }
                    if (Model.Enlem.HasValue && Model.Boylam.HasValue)
                    {
                        <div class="rounded-4 overflow-hidden border shadow-sm">
                            <div id="haritaDetay" style="height:320px;"></div>
                        </div>
                        <div class="small text-muted mt-2"><i class="bi bi-geo me-1"></i>Koordinat: @Model.Enlem.Value.ToString("0.######") , @Model.Boylam.Value.ToString("0.######")</div>
                    }
                }

                <div class="d-flex justify-content-between flex-wrap align-items-center gap-2 mt-4">
                    <div class="d-flex gap-2 flex-wrap">
                        @if (Model.AktifMi && (Model.Durum == "Depoda" || Model.Durum == "Yeni Kayıt" || string.IsNullOrWhiteSpace(Model.Durum)))
                        {
                            <a asp-controller="Eslesme"
                               asp-action="YeniEslesme"
                               asp-route-esyaId="@Model.Id"
                               class="btn btn-outline-primary rounded-3 px-4 py-2 shadow-sm">
                                <i class="bi bi-link-45deg me-2"></i>
                                <strong>Bu Eşyayı Eşleştir</strong>
                            </a>
                        }
                    </div>

                    <a asp-controller="KayipEsya"
                       asp-action="Index"
                       class="btn btn-secondary rounded-3 px-4 py-2">
                        <i class="bi bi-arrow-left me-2"></i>
                        Listeye Dön
                    </a>

                </div>

            </div>

        </div>

    </div>
</div>

@if (Model.Enlem.HasValue && Model.Boylam.HasValue)
{
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        (function(){
            const enlem = @Model.Enlem.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const boylam = @Model.Boylam.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const map = L.map('haritaDetay').setView([enlem, boylam], 15);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap contributors', maxZoom: 19 }).addTo(map);
            L.marker([enlem, boylam]).addTo(map).bindPopup('<b style="font-size:13px;">Bulunma Yeri</b><br/><small class="text-muted">@(Model.EsyaAdi.Replace("'","\\'"))</small>').openPopup();
        })();
    </script>
}
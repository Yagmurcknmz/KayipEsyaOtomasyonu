@model KayipEsyaOtomasyonu.Models.KayipEsya

@{
    ViewData["Title"] = "Kayıp Eşya Düzenle";

    string DurumRengi = Model.Durum switch
    {
        "Yeni Kayıt"             => "bg-primary bg-opacity-10 text-primary border-primary",
        "Depoda"                 => "bg-secondary bg-opacity-10 text-secondary border-secondary",
        "Eşleşme Bulundu"        => "bg-warning bg-opacity-10 text-warning border-warning",
        "Vatandaşa Haber Verildi"=> "bg-info bg-opacity-10 text-info border-info",
        "Teslim Bekliyor"        => "bg-indigo bg-opacity-10 border" ,
        "Teslim Edildi"          => "bg-success bg-opacity-10 text-success border-success",
        "Arşivlendi"             => "bg-dark bg-opacity-10 text-dark border-dark",
        _                        => "bg-light border-secondary text-dark"
    };
}

<div class="row justify-content-center">
    <div class="col-xxl-11 col-xl-12">

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">

            <div class="card-header bg-white py-3 border-0 border-bottom">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center justify-content-center bg-warning bg-opacity-10 rounded-3" style="width:52px;height:52px;">
                            <i class="bi bi-pencil-square fs-3 text-warning"></i>
                        </div>
                        <div>
                            <h4 class="mb-0 fw-bold">Kayıp Eşya Kaydını Düzenle</h4>
                            <small class="text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                Eşya bilgilerini güncelleyiniz. Kırmızı
                                <span class="text-danger">*</span> ile işaretli alanlar zorunludur.
                            </small>
                        </div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <span class="badge rounded-pill bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-3 py-2">
                            <i class="bi bi-calendar-event me-1"></i>
                            Oluşturma: @Model.OlusturmaTarihi.ToString("dd.MM.yyyy")
                        </span>
                        <span class="badge rounded-pill @DurumRengi border border-opacity-25 px-3 py-2" style="@(Model.Durum == "Teslim Bekliyor" ? "color:#4f46e5;border-color:#4f46e5;background:rgba(79,70,229,.08);" : "")">
                            <i class="bi bi-signpost me-1"></i>
                            @Model.Durum
                        </span>
                        <span class="badge rounded-pill @(Model.AktifMi ? "bg-success bg-opacity-10 text-success border-success" : "bg-danger bg-opacity-10 text-danger border-danger") border border-opacity-25 px-3 py-2">
                            <i class="bi @(Model.AktifMi ? "bi-check-circle" : "bi-slash-circle") me-1"></i>
                            @(Model.AktifMi ? "Aktif Kayıt" : "Pasif Kayıt")
                        </span>
                    </div>
                </div>
            </div>

            <div class="card-body p-4 bg-light bg-opacity-25">

                <form asp-controller="KayipEsya"
                      asp-action="Edit"
                      asp-route-id="@Model.Id"
                      method="post"
                      enctype="multipart/form-data"
                      novalidate>

                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="OlusturmaTarihi" />

                    <div asp-validation-summary="All"
                         class="alert alert-danger border-0 rounded-3 d-none">
                    </div>

                    <div class="row g-4 mb-4">

                        <!-- #################### SOL KOLON: GENEL BİLGİLER #################### -->
                        <div class="col-lg-7">

                            <div class="card border h-100 rounded-3 shadow-sm">
                                <div class="card-header bg-white py-2 border-bottom pb-3">
                                    <h6 class="mb-0 fw-semibold text-primary d-flex align-items-center">
                                        <i class="bi bi-card-heading me-2 fs-5"></i>
                                        Genel Bilgiler
                                    </h6>
                                </div>
                                <div class="card-body bg-white">

                                    <div class="row g-3">

                                        <div class="col-12">
                                            <label asp-for="EsyaAdi" class="form-label fw-semibold small text-uppercase text-muted mb-1">
                                                Eşya Adı<span class="text-danger ms-1">*</span>
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0">
                                                    <i class="bi bi-tag text-secondary"></i>
                                                </span>
                                                <input asp-for="EsyaAdi"
                                                       class="form-control border-start-0 ps-0"
                                                       placeholder="Örneğin: Siyah deri sırt çantası" />
                                            </div>
                                            <span asp-validation-for="EsyaAdi"
                                                  class="text-danger small d-block mt-1"></span>
                                        </div>

                                        <div class="col-12">
                                            <label asp-for="KategoriId" class="form-label fw-semibold small text-uppercase text-muted mb-1">
                                                Kategori<span class="text-danger ms-1">*</span>
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0 align-items-start" style="padding-top:.85rem;">
                                                    <i class="bi bi-funnel text-secondary"></i>
                                                </span>
                                                <select asp-for="KategoriId"
                                                        asp-items="ViewBag.Kategoriler"
                                                        size="12"
                                                        class="form-select border-start-0 ps-0"
                                                        style="min-height:48px;">
                                                    <option value="">Kategori seçiniz (12 kategori)</option>
                                                </select>
                                            </div>
                                            <small class="text-muted d-block mt-1">
                                                <i class="bi bi-info-circle me-1"></i>
                                                Yukarı/aşağı ok tuşları ile gezebilir veya tıklayıp seçebilirsiniz.
                                            </small>
                                            <span asp-validation-for="KategoriId"
                                                  class="text-danger small d-block mt-1"></span>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="Marka" class="form-label fw-semibold small text-uppercase text-muted mb-1">
                                                Marka
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0">
                                                    <i class="bi bi-bookmark-star text-secondary"></i>
                                                </span>
                                                <input asp-for="Marka"
                                                       class="form-control border-start-0 ps-0"
                                                       placeholder="Örneğin: Samsung" />
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="Model" class="form-label fw-semibold small text-uppercase text-muted mb-1">
                                                Model
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0">
                                                    <i class="bi bi-braces text-secondary"></i>
                                                </span>
                                                <input asp-for="Model"
                                                       class="form-control border-start-0 ps-0"
                                                       placeholder="Örneğin: Galaxy S24" />
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="Renk" class="form-label fw-semibold small text-uppercase text-muted mb-1">
                                                Renk
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0">
                                                    <i class="bi bi-palette text-secondary"></i>
                                                </span>
                                                <input asp-for="Renk"
                                                       class="form-control border-start-0 ps-0"
                                                       placeholder="Örneğin: Siyah" />
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="SeriNo" class="form-label fw-semibold small text-uppercase text-muted mb-1">
                                                Seri / IMEI Numarası
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0">
                                                    <i class="bi bi-upc-scan text-secondary"></i>
                                                </span>
                                                <input asp-for="SeriNo"
                                                       class="form-control border-start-0 ps-0 font-monospace"
                                                       placeholder="Varsa seri / IMEI no" />
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>

                        </div>

                        <!-- #################### SAĞ KOLON: KONUM & DURUM #################### -->
                        <div class="col-lg-5">

                            <div class="card border h-100 rounded-3 shadow-sm">
                                <div class="card-header bg-white py-2 border-bottom pb-3">
                                    <h6 class="mb-0 fw-semibold text-success d-flex align-items-center">
                                        <i class="bi bi-geo-alt me-2 fs-5"></i>
                                        Bulunma Konumu &amp; Durum
                                    </h6>
                                </div>
                                <div class="card-body bg-white">

                                    <div class="row g-3">

                                        <div class="col-md-6">
                                            <label asp-for="BulunmaTarihi" class="form-label fw-semibold small text-uppercase text-muted mb-1">
                                                Bulunma Tarihi<span class="text-danger ms-1">*</span>
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0">
                                                    <i class="bi bi-calendar3 text-secondary"></i>
                                                </span>
                                                <input asp-for="BulunmaTarihi"
                                                       type="date"
                                                       class="form-control border-start-0 ps-0" />
                                            </div>
                                            <span asp-validation-for="BulunmaTarihi"
                                                  class="text-danger small d-block mt-1"></span>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="Durum" class="form-label fw-semibold small text-uppercase text-muted mb-1">
                                                Durum<span class="text-danger ms-1">*</span>
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0">
                                                    <i class="bi bi-signpost text-secondary"></i>
                                                </span>
                                                <select asp-for="Durum"
                                                        class="form-select border-start-0 ps-0">
                                                    <option value="Yeni Kayıt">🆕 Yeni Kayıt</option>
                                                    <option value="Depoda">📦 Depoda</option>
                                                    <option value="Eşleşme Bulundu">🔗 Eşleşme Bulundu</option>
                                                    <option value="Vatandaşa Haber Verildi">📞 Vatandaşa Haber</option>
                                                    <option value="Teslim Bekliyor">⏳ Teslim Bekliyor</option>
                                                    <option value="Teslim Edildi">✅ Teslim Edildi</option>
                                                    <option value="Arşivlendi">📚 Arşivlendi</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <label asp-for="BulunmaYeri" class="form-label fw-semibold small text-uppercase text-muted mb-1">
                                                Bulunma Yeri
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0">
                                                    <i class="bi bi-geo text-secondary"></i>
                                                </span>
                                                <input asp-for="BulunmaYeri"
                                                       class="form-control border-start-0 ps-0"
                                                       placeholder="Örneğin: Arnavutköy Meydanı, tramvay durağı" />
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="Mahalle" class="form-label fw-semibold small text-uppercase text-muted mb-1">
                                                Mahalle
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0">
                                                    <i class="bi bi-signpost-split text-secondary"></i>
                                                </span>
                                                <input asp-for="Mahalle"
                                                       class="form-control border-start-0 ps-0"
                                                       placeholder="Örneğin: Merkez Mahallesi" />
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="Birim" class="form-label fw-semibold small text-uppercase text-muted mb-1">
                                                Teslim Alan Birim
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0">
                                                    <i class="bi bi-building text-secondary"></i>
                                                </span>
                                                <input asp-for="Birim"
                                                       class="form-control border-start-0 ps-0"
                                                       placeholder="Örneğin: Zabıta Müdürlüğü" />
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label asp-for="RafNo" class="form-label fw-semibold small text-uppercase text-muted mb-1">
                                                Raf / Dolap Numarası
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0">
                                                    <i class="bi bi-grid-3x3-gap text-secondary"></i>
                                                </span>
                                                <input asp-for="RafNo"
                                                       class="form-control border-start-0 ps-0 font-monospace"
                                                       placeholder="Örneğin: A-12 / Koli 5" />
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-check form-switch mt-4 p-3 border rounded-2 bg-light bg-opacity-50">
                                                <input asp-for="AktifMi"
                                                       class="form-check-input"
                                                       type="checkbox"
                                                       role="switch"
                                                       id="aktifSwitch">
                                                <label class="form-check-label fw-semibold small text-uppercase text-muted ms-2" for="aktifSwitch">
                                                    Kayıt Aktif
                                                </label>
                                                <small class="d-block text-muted mt-1">
                                                    <i class="bi bi-lightbulb me-1"></i>
                                                    Pasif yapıldığında aramalarda görünmez.
                                                </small>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- #################### AÇIKLAMALAR BÖLÜMÜ #################### -->
                    <div class="row g-4 mb-4">

                        <div class="col-md-6">
                            <div class="card border rounded-3 shadow-sm">
                                <div class="card-header bg-white py-2 border-bottom pb-3">
                                    <h6 class="mb-0 fw-semibold text-warning d-flex align-items-center">
                                        <i class="bi bi-stars me-2 fs-5"></i>
                                        Ayırt Edici Özellikler
                                    </h6>
                                </div>
                                <div class="card-body bg-white">
                                    <label asp-for="AyirtEdiciOzellik" class="form-label small text-muted fw-medium mb-1">
                                        Eşyayı diğer eşyalardan ayıran özel detaylar (çizik, leke, desen, yazı vb.)
                                    </label>
                                    <textarea asp-for="AyirtEdiciOzellik"
                                              class="form-control rounded-2"
                                              rows="5"
                                              placeholder="Örneğin: Kilit mekanizmasında çatlak var, fermuar kırık, içine yazılmış isim vb."></textarea>
                                    <div class="mt-2 small text-muted">
                                        <i class="bi bi-lightbulb me-1"></i>
                                        En fazla 500 karakter girebilirsiniz.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card border rounded-3 shadow-sm">
                                <div class="card-header bg-white py-2 border-bottom pb-3">
                                    <h6 class="mb-0 fw-semibold d-flex align-items-center" style="color:#4f46e5;">
                                        <i class="bi bi-journal-text me-2 fs-5"></i>
                                        Açıklama
                                    </h6>
                                </div>
                                <div class="card-body bg-white">
                                    <label asp-for="Aciklama" class="form-label small text-muted fw-medium mb-1">
                                        Eşya hakkında genel not, teslim şekli, bulunan kişi bilgisi vb.
                                    </label>
                                    <textarea asp-for="Aciklama"
                                              class="form-control rounded-2"
                                              rows="5"
                                              placeholder="Eşya ve olay hakkında ek bilgiler buraya yazılabilir."></textarea>
                                    <div class="mt-2 small text-muted">
                                        <i class="bi bi-lightbulb me-1"></i>
                                        En fazla 1000 karakter girebilirsiniz.
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- #################### ADIM 3: RESIMLER (MEVCUT + YENI YUKLEME) #################### -->
                    @{
                        var kayipEsyaResimleri = Model.Resimler?.Where(r => r.AktifMi).OrderBy(r => r.SiraNumarasi).ToList() ?? new List<KayipEsyaResim>();
                        var kalanKapasite = Math.Max(0, 5 - kayipEsyaResimleri.Count);
                    }
                    <div class="card rounded-4 shadow-sm mt-4">
                        <div class="card-header py-3 border-bottom-0">
                            <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                                <h6 class="mb-0 fw-semibold text-success">
                                    <i class="bi bi-images me-2 fs-5"></i>
                                    Fotoğraflar
                                    <span class="badge rounded-pill text-bg-success ms-2">@kayipEsyaResimleri.Count / 5</span>
                                </h6>
                                <small class="text-muted opacity-75">
                                    <i class="bi bi-info-circle me-1"></i>
                                    JPG / PNG format, en fazla 20 MB
                                </small>
                            </div>
                        </div>
                        <div class="card-body pt-0">
                            @if (kayipEsyaResimleri.Any())
                            {
                                <div class="row g-3 mt-2 mb-4">
                                    @for (int i = 0; i < kayipEsyaResimleri.Count; i++)
                                    {
                                        var r = kayipEsyaResimleri[i];
                                        var buyukYol = (!string.IsNullOrWhiteSpace(r.DosyaYolu) ? "/" + r.DosyaYolu.Replace("\\", "/") : "")!;
                                        var onizleme = !string.IsNullOrWhiteSpace(r.ThumbnailYolu) ? ("/" + r.ThumbnailYolu.Replace("\\", "/")) : buyukYol;
                                        <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                                            <div class="position-relative resim-kart"
                                                 style="overflow:hidden;border-radius:16px;box-shadow:0 4px 14px rgba(15,23,42,0.10);">
                                                <a href="@buyukYol" target="_blank" class="d-block">
                                                    <img src="@onizleme"
                                                         alt="Fotoğraf @(i+1)"
                                                         class="w-100 img-fluid object-fit-cover"
                                                         style="aspect-ratio:1/1;display:block;" />
                                                </a>
                                                <div class="position-absolute top-2 start-2 d-flex gap-2">
                                                    <span class="badge text-bg-dark bg-opacity-80 rounded-pill px-2 py-1 small">#@(i+1)</span>
                                                    @if (r.VarsayilanResimMi)
                                                    {
                                                        <span class="badge text-bg-success rounded-pill px-2 py-1 small">
                                                            <i class="bi bi-star-fill me-1"></i>Kapak
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-light border-dashed rounded-3 text-center mt-2 mb-4 py-4">
                                    <i class="bi bi-image text-muted opacity-50 fs-2"></i>
                                    <div class="small text-muted mt-2 mb-0">Henüz fotoğraf yüklenmemiş. Aşağıdan yeni fotoğraf ekleyebilirsiniz.</div>
                                </div>
                            }

                            @if (kalanKapasite > 0)
                            {
                                <label class="form-label fw-semibold small text-uppercase text-muted mb-2">
                                    Yeni Fotoğraf Yükle <span class="text-muted fw-normal opacity-75 text-lowercase">(en fazla @kalanKapasite adet)</span>
                                </label>
                                <div class="p-4 rounded-3"
                                     style="border:2px dashed #fca5a5;background:linear-gradient(135deg,#fff1f2 0%,#fff7ed 100%);">
                                    <div class="row align-items-center g-3">
                                        <div class="col-sm-9">
                                            <input type="file"
                                                   id="ResimDosyalari"
                                                   name="ResimDosyalari"
                                                   accept="image/*"
                                                   multiple
                                                   class="form-control form-control-lg rounded-3 border-0 bg-white shadow-sm" />
                                            <div id="yuklenenSayac" class="small text-muted mt-2 ms-1">
                                                <i class="bi bi-check2-circle me-1 text-success"></i>
                                                Henüz dosya seçilmedi
                                            </div>
                                        </div>
                                        <div class="col-sm-3 d-grid">
                                            <button type="button" onclick="document.getElementById('ResimDosyalari').click();"
                                                    class="btn btn-danger btn-lg rounded-3 shadow-sm fw-semibold"
                                                    style="background:linear-gradient(90deg,#ef4444,#f97316);border:none;">
                                                <i class="bi bi-cloud-arrow-up-fill me-1"></i>
                                                Seç
                                            </button>
                                        </div>
                                    </div>
                                    <div class="progress mt-3" style="height:7px;">
                                        <div id="resimProgress" class="progress-bar rounded-pill"
                                             style="background:linear-gradient(90deg,#ef4444,#f97316);width:0%;"></div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info rounded-3 text-center mb-0 small">
                                    <i class="bi bi-folder-symlink me-1"></i>
                                    Fotoğraf limiti (<strong>5</strong>) doldu. Yeni fotoğraf ekleyebilmek için mevcut olanlardan birini silmelisiniz.
                                </div>
                            }
                        </div>
                    </div>

                    <!-- #################### ADIM 4: KONUM (BULUNDUGU YER - MAP + ADRES) #################### -->
                    <div class="card rounded-4 shadow-sm mt-4">
                        <div class="card-header py-3 border-bottom-0">
                            <h6 class="mb-0 fw-semibold text-danger">
                                <i class="bi bi-geo-alt-fill me-2 fs-5"></i>
                                Bulunduğu Konum & Adres
                            </h6>
                        </div>
                        <div class="card-body pt-0">
                            <input type="hidden" asp-for="Enlem" id="Enlem" />
                            <input type="hidden" asp-for="Boylam" id="Boylam" />

                            <div id="konumOnizleme"
                                 class="p-3 mb-3 rounded-3 d-flex align-items-center gap-3"
                                 style="background:linear-gradient(135deg,#eff6ff 0%,#f0fdfa 100%);">
                                <span class="badge rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2"
                                      style="background:#dbeafe;color:#1d4ed8;">
                                    <i class="bi bi-geo-alt-fill fs-5"></i>
                                </span>
                                <div class="flex-grow-1">
                                    <div id="konumDurum" class="small fw-semibold text-primary mb-1">
                                        @if (Model.Enlem.HasValue && Model.Boylam.HasValue)
                                        {
                                            <text>Konum daha önce kaydedilmiş ✓</text>
                                        }
                                        else
                                        {
                                            <text>Haritadan tıklayarak konumu işaretleyin</text>
                                        }
                                    </div>
                                    <div id="konumKoordinat" class="small text-muted mb-0 font-monospace">
                                        @if (Model.Enlem.HasValue && Model.Boylam.HasValue)
                                        {
                                            <text>@Model.Enlem.Value.ToString("F6") , @Model.Boylam.Value.ToString("F6")</text>
                                        }
                                        else
                                        {
                                            <text>Henüz konum seçilmedi</text>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div id="harita"
                                 class="rounded-3 border"
                                 style="height:320px;min-height:320px;"></div>

                            <div class="mt-4">
                                <label asp-for="AdresDetayi" class="form-label fw-semibold small text-uppercase text-muted mb-2">
                                    Açık Adres / Tarif
                                    <span class="text-muted fw-normal opacity-75 text-lowercase ms-1">(isteğe bağlı)</span>
                                </label>
                                <textarea asp-for="AdresDetayi"
                                          rows="3"
                                          class="form-control rounded-3"
                                          placeholder="Örn: İstanbul Cad. no:123 A Blok Kat:2 Daire:5 - Mahalle: Cumhuriyet"></textarea>
                                <span asp-validation-for="AdresDetayi" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </div>

                    <!-- #################### FORM FOOTER (BUTONLAR) #################### -->
                    <div class="card-footer bg-white border-0 border-top rounded-4 mt-2 pt-4 px-0 d-flex justify-content-sm-end justify-content-between align-items-center flex-wrap gap-2">

                        <div class="small text-muted order-2 order-sm-1">
                            <i class="bi bi-clock-history me-1"></i>
                            @if (Model.GuncellenmeTarihi.HasValue)
                            {
                                <text>Son güncelleme: <strong>@Model.GuncellenmeTarihi.Value.ToString("dd.MM.yyyy HH:mm")</strong></text>
                            }
                            else
                            {
                                <text>Kayıt henüz güncellenmemiş.</text>
                            }
                        </div>

                        <div class="d-flex gap-2 order-1 order-sm-2">
                            <a asp-controller="KayipEsya"
                               asp-action="Index"
                               class="btn btn-outline-secondary px-4 rounded-3 shadow-sm">
                                <i class="bi bi-arrow-left me-1"></i>
                                Listeye Dön
                            </a>
                            <a asp-controller="KayipEsya"
                               asp-action="Details"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-info px-4 rounded-3 shadow-sm">
                                <i class="bi bi-eye me-1"></i>
                                Detayları Gör
                            </a>
                            <button type="submit"
                                    class="btn btn-warning px-5 rounded-3 shadow btn-lg-sm text-dark">
                                <i class="bi bi-arrow-repeat me-2"></i>
                                Güncelle
                            </button>
                        </div>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
        (function () {
            var inputEnlem = document.getElementById('Enlem');
            var inputBoylam = document.getElementById('Boylam');
            var konumPanel = document.getElementById('konumOnizleme');
            var durumEl = document.getElementById('konumDurum');
            var koordinatEl = document.getElementById('konumKoordinat');
            var fileInput = document.getElementById('ResimDosyalari');
            var sayacEl = document.getElementById('yuklenenSayac');
            var progressEl = document.getElementById('resimProgress');

            function panelGuncelle(lat, lng) {
                if (lat !== null && lng !== null) {
                    konumPanel.style.background = 'linear-gradient(135deg,#dcfce7 0%,#f0fdfa 100%)';
                    var span = konumPanel.querySelector('.rounded-pill');
                    if (span) {
                        span.style.background = '#bbf7d0';
                        span.style.color = '#166534';
                        span.innerHTML = '<i class="bi bi-check-circle-fill fs-5"></i>';
                    }
                    durumEl.textContent = 'Konum başarıyla işaretlendi ✓';
                    durumEl.className = durumEl.className.replace('text-primary', 'text-success');
                    if (!durumEl.classList.contains('text-success')) durumEl.classList.add('text-success');
                    koordinatEl.textContent = lat.toFixed(6) + ' , ' + lng.toFixed(6);
                } else {
                    konumPanel.style.background = 'linear-gradient(135deg,#eff6ff 0%,#f0fdfa 100%)';
                    var span2 = konumPanel.querySelector('.rounded-pill');
                    if (span2) {
                        span2.style.background = '#dbeafe';
                        span2.style.color = '#1d4ed8';
                        span2.innerHTML = '<i class="bi bi-geo-alt-fill fs-5"></i>';
                    }
                    durumEl.textContent = 'Haritadan tıklayarak konumu işaretleyin';
                    koordinatEl.textContent = 'Henüz konum seçilmedi';
                }
            }

            window.addEventListener('DOMContentLoaded', function () {
                var initLat = (inputEnlem && inputEnlem.value && !isNaN(parseFloat(inputEnlem.value))) ? parseFloat(inputEnlem.value) : 39.9334;
                var initLng = (inputBoylam && inputBoylam.value && !isNaN(parseFloat(inputBoylam.value))) ? parseFloat(inputBoylam.value) : 32.8597;
                var hasInitial = inputEnlem && inputEnlem.value && !isNaN(parseFloat(inputEnlem.value)) && inputBoylam && inputBoylam.value && !isNaN(parseFloat(inputBoylam.value));

                try {
                    var map = L.map('harita', { scrollWheelZoom: false }).setView([initLat, initLng], hasInitial ? 15 : 6);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        maxZoom: 19,
                        attribution: '&copy; OpenStreetMap'
                    }).addTo(map);

                    var marker = null;
                    if (hasInitial) {
                        marker = L.marker([initLat, initLng], { draggable: true, autoPan: true }).addTo(map);
                        marker.bindPopup('<div style="padding:4px 2px;"><strong style="color:#16a34a;"><i class="bi bi-pin-map-fill me-1"></i>Bulunduğu Konum</strong><div style="font-size:12px;color:#64748b;margin-top:4px;">Konumu taşıyarak düzeltebilirsiniz</div></div>', { closeButton: false, maxWidth: 280 }).openPopup();
                        marker.on('dragend', function () {
                            var p = marker.getLatLng();
                            inputEnlem.value = p.lat;
                            inputBoylam.value = p.lng;
                            panelGuncelle(p.lat, p.lng);
                        });
                        panelGuncelle(initLat, initLng);
                    }

                    map.on('click', function (e) {
                        inputEnlem.value = e.latlng.lat;
                        inputBoylam.value = e.latlng.lng;
                        if (marker) {
                            marker.setLatLng(e.latlng);
                        } else {
                            marker = L.marker(e.latlng, { draggable: true, autoPan: true }).addTo(map);
                            marker.on('dragend', function () {
                                var p2 = marker.getLatLng();
                                inputEnlem.value = p2.lat;
                                inputBoylam.value = p2.lng;
                                panelGuncelle(p2.lat, p2.lng);
                            });
                        }
                        if (!marker.isPopupOpen()) {
                            marker.bindPopup('<div style="padding:4px 2px;"><strong style="color:#16a34a;"><i class="bi bi-pin-map-fill me-1"></i>Bulunduğu Konum</strong><div style="font-size:12px;color:#64748b;margin-top:4px;">Konumu taşıyarak düzeltebilirsiniz</div></div>', { closeButton: false, maxWidth: 280 }).openPopup();
                        }
                        panelGuncelle(e.latlng.lat, e.latlng.lng);
                    });

                    setTimeout(function () { map.invalidateSize(true); }, 200);
                } catch (err) {
                    console.error('Harita yüklenirken hata:', err);
                }

                if (fileInput) {
                    fileInput.addEventListener('change', function () {
                        var n = this.files ? this.files.length : 0;
                        if (sayacEl) {
                            if (n > 0) {
                                sayacEl.innerHTML = '<i class="bi bi-check2-circle me-1 text-success"></i>' + n + ' dosya seçildi';
                            } else {
                                sayacEl.innerHTML = '<i class="bi bi-check2-circle me-1 text-success"></i>Henüz dosya seçilmedi';
                            }
                        }
                        if (progressEl) {
                            var oran = Math.min(100, (n / 5) * 100);
                            progressEl.style.width = oran + '%';
                        }
                    });
                }
            });
        })();
    </script>
    <style>
        .resim-kart:hover img { transform: scale(1.035); transition: transform 0.25s ease; }
        .resim-kart img { transition: transform 0.25s ease; }
        .leaflet-popup-content-wrapper { border-radius: 14px !important; box-shadow: 0 10px 28px rgba(15,23,42,0.18) !important; }
    </style>
}

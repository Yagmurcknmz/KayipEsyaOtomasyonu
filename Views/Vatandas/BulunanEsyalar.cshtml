@model KayipEsyaOtomasyonu.ViewModels.EsyaSorgulamaViewModel

@{
    ViewData["Title"] = "Eşya Sorgulama";
    Layout = "~/Views/Shared/_VatandasLayout.cshtml";

    var kategoriler = ViewBag.Kategoriler as IEnumerable<KayipEsyaOtomasyonu.Models.Kategori> ?? Enumerable.Empty<KayipEsyaOtomasyonu.Models.Kategori>();
    var seciliKategori = Model?.KategoriId;
    var arananMetin = Model?.Aranan ?? "";

    // Skor badge yardimcisi (renk+ikon):
    (string Sinif, string Ikon, string Etiket) SkorBilgi(int s) => s switch
    {
        >= 90 => ("skor-mukemmel",   "bi bi-stars",               "Mükemmel"),
        >= 75 => ("skor-yuksek",     "bi bi-check-circle-fill",  "Yüksek"),
        >= 55 => ("skor-orta",       "bi bi-hand-thumbs-up",     "Orta"),
        >= 35 => ("skor-kismi",      "bi bi-exclamation-circle-fill", "Kısmi"),
        _     => ("skor-dusuk",      "bi bi-x-circle-fill",     "Düşük"),
    };

    // Dictionary'leri al (ViewBag dynamic oldugu icin cast et):
    var esyaSkorlari = ViewBag.FuzzyEsyaSkorlari as Dictionary<int, int> ?? new Dictionary<int, int>();
    var basvuruSkorlari = ViewBag.FuzzyBasvuruSkorlari as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="dashboard-header mb-4">
    <div>
        <h2>Eşya Sorgulama</h2>
        <p class="text-muted mb-0">
            Hem belediyemize teslim edilen bulunan eşyaları arayabilir, hem de kendi kayıp başvurularınızı inceleyebilirsiniz.
        </p>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-controller="Vatandas"
              asp-action="BulunanEsyalar"
              method="get"
              class="row g-3 align-items-end">

            <div class="col-12 col-md-5">
                <label class="form-label fw-semibold">Ara</label>
                <input type="text"
                       name="aranan"
                       value="@arananMetin"
                       class="form-control"
                       placeholder="Eşya adı, marka, model, renk, bulunma yeri, raf no..." />
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold">Kategori</label>
                <select name="kategoriId"
                        class="form-select">
                    <option value="">Tüm Kategoriler</option>
                    @foreach (var ktg in kategoriler)
                    {
                        <option value="@ktg.Id"
                                selected="@(seciliKategori == ktg.Id)">
                            @ktg.Ad
                        </option>
                    }
                </select>
            </div>

            <div class="col-12 col-md-3 d-grid">
                <button type="submit"
                        class="btn btn-primary">
                    <i class="bi bi-search me-2"></i>
                    Sorgula
                </button>
            </div>

        </form>
    </div>
</div>

<ul class="nav nav-tabs nav-fill border rounded-3 bg-white p-1 mb-4 shadow-sm" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active rounded-2 fw-semibold py-2"
                id="tab-bulunanlar"
                data-bs-toggle="tab"
                data-bs-target="#tab-pane-bulunanlar"
                type="button"
                role="tab">
            <i class="bi bi-search text-primary me-2"></i>
            Bulunan Eşyalar
            <span class="badge bg-primary rounded-pill ms-1">@(Model?.BulunanEsyalar?.Count ?? 0)</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link rounded-2 fw-semibold py-2"
                id="tab-basvurularim"
                data-bs-toggle="tab"
                data-bs-target="#tab-pane-basvurularim"
                type="button"
                role="tab">
            <i class="bi bi-clipboard2-list text-success me-2"></i>
            Benim Kayıp Başvurularım
            <span class="badge bg-success rounded-pill ms-1">@(Model?.KendiKayipBildirilerim?.Count ?? 0)</span>
        </button>
    </li>
</ul>

<div class="tab-content" id="esyaTabContent">

    <div class="tab-pane fade show active" id="tab-pane-bulunanlar" role="tabpanel">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0">
                    <i class="bi bi-inbox text-primary me-2"></i>
                    Beldeye Teslim Bulunan Eşyalar
                </h5>
                <small class="text-muted">
                    Toplam @(Model?.BulunanEsyalar?.Count ?? 0) kayıt
                </small>
            </div>

            <div class="card-body">

                @if (Model?.BulunanEsyalar == null || !Model.BulunanEsyalar.Any())
                {
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <i class="bi bi-search"></i>
                        </div>

                        <h5>Aramanıza uygun bulunan eşya yok</h5>

                        <p>
                            Farklı bir kelime veya kategori deneyin. Ayrıca "Benim Kayıp Başvurularım" sekmesini kontrol edin.
                        </p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th style="width:90px;">Görsel</th>
                                    @if (!string.IsNullOrWhiteSpace(arananMetin))
                                    {
                                        <th style="width:140px;">Benzerlik %</th>
                                    }
                                    <th>Eşya</th>
                                    <th>Kategori</th>
                                    <th>Marka / Model</th>
                                    <th>Renk</th>
                                    <th>Bulunma Tarihi</th>
                                    <th>Bulunma Yeri</th>
                                    <th>Raf No</th>
                                    <th>Durum</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var esya in Model.BulunanEsyalar)
                                {
                                    var kapakResim = esya.Resimler?.FirstOrDefault(r => r.AktifMi);
                                    var kapakYol = kapakResim != null ?
                                        (!string.IsNullOrWhiteSpace(kapakResim.ThumbnailYolu) ? ("/" + kapakResim.ThumbnailYolu.Replace("\\", "/")) : (!string.IsNullOrWhiteSpace(kapakResim.DosyaYolu) ? ("/" + kapakResim.DosyaYolu.Replace("\\", "/")) : null))
                                        : null;

                                    int skor = 0;
                                    var sb = (Sinif: "skor-dusuk", Ikon: "bi bi-x-circle-fill", Etiket: "Düşük");
                                    bool skorGoster = !string.IsNullOrWhiteSpace(arananMetin) && esyaSkorlari.TryGetValue(esya.Id, out skor);
                                    if (skorGoster) sb = SkorBilgi(skor);

                                    <tr>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(kapakYol))
                                            {
                                                <img src="@kapakYol"
                                                     alt="@esya.EsyaAdi"
                                                     class="rounded-3 object-fit-cover"
                                                     style="width:68px;height:68px;box-shadow:0 4px 12px rgba(15,23,42,0.12);" />
                                            }
                                            else
                                            {
                                                <div class="rounded-3 d-flex align-items-center justify-content-center text-muted bg-light"
                                                     style="width:68px;height:68px;">
                                                    <i class="bi bi-image fs-3 opacity-40"></i>
                                                </div>
                                            }
                                        </td>
                                        @if (skorGoster)
                                        {
                                            <td>
                                                <span class="skor-badge @sb.Sinif" title="@sb.Etiket benzerlik">
                                                    <i class="@sb.Ikon"></i>
                                                    <span>%@skor</span>
                                                </span>
                                            </td>
                                        }
                                        <td><strong>@esya.EsyaAdi</strong></td>
                                        <td>@(esya.Kategori?.Ad ?? "-")</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(esya.Marka))
                                            {
                                                <div>@esya.Marka</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(esya.Model))
                                            {
                                                <small class="text-muted">@esya.Model</small>
                                            }
                                            @if (string.IsNullOrWhiteSpace(esya.Marka) &&
                                                string.IsNullOrWhiteSpace(esya.Model))
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(esya.Renk) ? "-" : esya.Renk)</td>
                                        <td>@esya.BulunmaTarihi.ToString("dd.MM.yyyy")</td>
                                        <td>@(string.IsNullOrWhiteSpace(esya.BulunmaYeri) ? "-" : esya.BulunmaYeri)</td>
                                        <td>@(string.IsNullOrWhiteSpace(esya.RafNo) ? "-" : esya.RafNo)</td>
                                        <td>
                                            @if (esya.Durum == "Teslim Edildi")
                                            {
                                                <span class="badge bg-success">@esya.Durum</span>
                                            }
                                            else if (esya.Durum == "Eşleşme Bulundu")
                                            {
                                                <span class="badge bg-info">@esya.Durum</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary">@esya.Durum</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="tab-pane-basvurularim" role="tabpanel">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0">
                    <i class="bi bi-person-check-fill text-success me-2"></i>
                    Sizin Kayıp Başvurularınız
                </h5>
                <small class="text-muted">
                    Toplam @(Model?.KendiKayipBildirilerim?.Count ?? 0) başvuru
                </small>
            </div>

            <div class="card-body">

                @if (Model?.KendiKayipBildirilerim == null || !Model.KendiKayipBildirilerim.Any())
                {
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <i class="bi bi-clipboard-x"></i>
                        </div>

                        <h5>Henüz kayıp başvurunuz yok</h5>

                        <p>
                            Üst menüden "Kayıp Bildir" butonuna tıklayarak ilk kayıp eşya başvurunuzu oluşturabilirsiniz.
                        </p>

                        <div class="mt-3">
                            <a asp-controller="KayipBildirimi"
                               asp-action="Create"
                               class="btn btn-success">
                                <i class="bi bi-plus-circle me-2"></i>
                                Hemen Kayıp Eşya Bildir
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th style="width:90px;">Görsel</th>
                                    @if (!string.IsNullOrWhiteSpace(arananMetin))
                                    {
                                        <th style="width:140px;">Benzerlik %</th>
                                    }
                                    <th>Başvuru No</th>
                                    <th>Kayıp Eşya</th>
                                    <th>Kategori</th>
                                    <th>Marka / Model</th>
                                    <th>Renk</th>
                                    <th>Kayıp Tarihi</th>
                                    <th>Kayıp Yeri</th>
                                    <th>Başvuru Durumu</th>
                                    <th>İşlem</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var b in Model.KendiKayipBildirilerim)
                                {
                                    var kapakResim = b.Resimler?.FirstOrDefault(r => r.AktifMi);
                                    var kapakYol = kapakResim != null ?
                                        (!string.IsNullOrWhiteSpace(kapakResim.ThumbnailYolu) ? ("/" + kapakResim.ThumbnailYolu.Replace("\\", "/")) : (!string.IsNullOrWhiteSpace(kapakResim.DosyaYolu) ? ("/" + kapakResim.DosyaYolu.Replace("\\", "/")) : null))
                                        : null;

                                    int skorBasvuru = 0;
                                    var sb2 = (Sinif: "skor-dusuk", Ikon: "bi bi-x-circle-fill", Etiket: "Düşük");
                                    bool skorGoster2 = !string.IsNullOrWhiteSpace(arananMetin) && basvuruSkorlari.TryGetValue(b.Id, out skorBasvuru);
                                    if (skorGoster2) sb2 = SkorBilgi(skorBasvuru);

                                    <tr>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(kapakYol))
                                            {
                                                <img src="@kapakYol"
                                                     alt="@b.EsyaAdi"
                                                     class="rounded-3 object-fit-cover"
                                                     style="width:68px;height:68px;box-shadow:0 4px 12px rgba(15,23,42,0.12);" />
                                            }
                                            else
                                            {
                                                <div class="rounded-3 d-flex align-items-center justify-content-center text-muted bg-light"
                                                     style="width:68px;height:68px;">
                                                    <i class="bi bi-image fs-3 opacity-40"></i>
                                                </div>
                                            }
                                        </td>
                                        @if (skorGoster2)
                                        {
                                            <td>
                                                <span class="skor-badge @sb2.Sinif" title="@sb2.Etiket benzerlik">
                                                    <i class="@sb2.Ikon"></i>
                                                    <span>%@skorBasvuru</span>
                                                </span>
                                            </td>
                                        }
                                        <td>
                                            <span class="badge bg-dark text-white">@b.BasvuruNo</span>
                                        </td>
                                        <td><strong>@b.EsyaAdi</strong></td>
                                        <td>@(b.Kategori?.Ad ?? "-")</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(b.Marka))
                                            {
                                                <div>@b.Marka</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(b.Model))
                                            {
                                                <small class="text-muted">@b.Model</small>
                                            }
                                            @if (string.IsNullOrWhiteSpace(b.Marka) &&
                                                string.IsNullOrWhiteSpace(b.Model))
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(b.Renk) ? "-" : b.Renk)</td>
                                        <td>@b.KayipTarihi.ToString("dd.MM.yyyy")</td>
                                        <td>@(string.IsNullOrWhiteSpace(b.KayipYeri) ? "-" : b.KayipYeri)</td>
                                        <td>
                                            @if (b.Durum == "Teslim Edildi")
                                            {
                                                <span class="badge bg-success">@b.Durum</span>
                                            }
                                            else if (b.Durum == "Eşleşme Bulundu")
                                            {
                                                <span class="badge bg-info text-dark">@b.Durum</span>
                                            }
                                            else if (b.Durum == "Başvuru Alındı")
                                            {
                                                <span class="badge bg-secondary">@b.Durum</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">@b.Durum</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-controller="KayipBildirimi"
                                               asp-action="Details"
                                               asp-route-id="@b.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye me-1"></i>
                                                Detay
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        </div>
    </div>

</div>

@model IEnumerable<Bildirim>
@using System.Linq
@{
    ViewData["Title"] = "Bildirimlerim";
    Layout = "~/Views/Shared/_VatandasLayout.cshtml";
    var okunmamis = Model.Count(b => !b.OkunduMu);
    var okunmus = Model.Count(b => b.OkunduMu);
}

<section class="container-fluid p-4">

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-0">
                <i class="bi bi-bell-fill me-2 text-primary"></i>
                Bildirimlerim
            </h4>
            <small class="text-muted">
                Toplam @Model.Count() adet bildirim · @okunmamis okunmamış · @okunmus okunmuş
            </small>
        </div>
        <div class="d-flex gap-2">
            @if (okunmamis > 0)
            {
                <form asp-controller="Home"
                      asp-action="TumBildirimleriOkunduYap"
                      method="post"
                      class="m-0">
                    <button type="submit"
                            class="btn btn-sm btn-outline-success rounded-3">
                        <i class="bi bi-check-all me-1"></i>
                        Tümünü Okundu İşaretle
                    </button>
                </form>
            }
            <a asp-action="Index"
               class="btn btn-sm btn-outline-secondary rounded-3">
                <i class="bi bi-arrow-left me-1"></i>
                Ana Sayfa
            </a>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-card-icon stat-primary">
                    <i class="bi bi-bell-fill"></i>
                </div>
                <div class="stat-card-content">
                    <span>Toplam Bildirim</span>
                    <h3>@Model.Count()</h3>
                    <small class="text-muted">Tüm bildirimleriniz</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-card-icon stat-danger">
                    <i class="bi bi-bell"></i>
                </div>
                <div class="stat-card-content">
                    <span>Okunmamış</span>
                    <h3>@okunmamis</h3>
                    <small class="text-muted">Hızlıca kontrol edin</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-card-icon stat-success">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div class="stat-card-content">
                    <span>Okunmuş</span>
                    <h3>@okunmus</h3>
                    <small class="text-muted">Geçmiş bildirimler</small>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Durum</th>
                        <th>Tür</th>
                        <th>Bildirim</th>
                        <th>İlgili Başvuru</th>
                        <th>Tarih</th>
                        <th class="pe-4 text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox display-5 opacity-25"></i>
                                <div class="mt-2">Henüz bildirim yok</div>
                            </td>
                        </tr>
                    }
                    @foreach (var b in Model)
                    {
                        var turIkon = b.Turu switch
                        {
                            BildirimTuru.EslesmeBulundu => "🪄",
                            BildirimTuru.TeslimOnayi => "✅",
                            BildirimTuru.BasvuruDurumu => "ℹ️",
                            BildirimTuru.GenelDuyuru => "📢",
                            _ => "🔔"
                        };
                        var turBadge = b.Turu switch
                        {
                            BildirimTuru.EslesmeBulundu => "bg-success-subtle text-success-emphasis",
                            BildirimTuru.TeslimOnayi => "bg-primary-subtle text-primary-emphasis",
                            BildirimTuru.BasvuruDurumu => "bg-info-subtle text-info-emphasis",
                            _ => "bg-secondary-subtle text-secondary-emphasis"
                        };
                        var turAd = b.Turu switch
                        {
                            BildirimTuru.EslesmeBulundu => "Eşleşme Bulundu",
                            BildirimTuru.TeslimOnayi => "Teslim Onayı",
                            BildirimTuru.BasvuruDurumu => "Başvuru Durumu",
                            BildirimTuru.GenelDuyuru => "Genel Duyuru",
                            _ => "Bildirim"
                        };
                        <tr class="@(b.OkunduMu ? "" : "unread-row")">
                            <td class="ps-4">
                                @if (!b.OkunduMu)
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="notification-dot bg-danger"></span>
                                        <span class="small-badge text-danger">Yeni</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="notification-dot bg-secondary-subtle"></span>
                                        <span class="small-badge text-secondary">Okundu</span>
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="badge rounded-pill @turBadge px-3 py-2">
                                    @turIkon @turAd
                                </span>
                            </td>
                            <td>
                                <div class="fw-semibold mb-1">@b.Baslik</div>
                                @if (!string.IsNullOrWhiteSpace(b.Icerik))
                                {
                                    <div class="small text-muted"
                                         style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;max-width:480px;">
                                        @b.Icerik
                                    </div>
                                }
                            </td>
                            <td>
                                @if (b.KayipBildirimi != null)
                                {
                                    <div>
                                        <div class="fw-semibold small">#@b.KayipBildirimi.Id @b.KayipBildirimi.EsyaAdi</div>
                                        @if (b.KayipBildirimi.Kategori != null)
                                        {
                                            <small class="text-muted">@b.KayipBildirimi.Kategori.Ad</small>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold small">
                                    @b.OlusturulmaTarihi.ToString("dd.MM.yyyy")
                                </div>
                                <small class="text-muted">
                                    @b.OlusturulmaTarihi.ToString("HH:mm")
                                    @if (b.OkunmaTarihi.HasValue)
                                    {
                                        <div class="text-success-emphasis mt-1">
                                            <i class="bi bi-check2-all me-1"></i>
                                            @b.OkunmaTarihi.Value.ToString("dd.MM HH:mm")
                                        </div>
                                    }
                                </small>
                            </td>
                            <td class="pe-4 text-end">
                                <a asp-action="BildirimOku"
                                   asp-route-id="@b.Id"
                                   class="btn btn-sm @(b.OkunduMu ? "btn-outline-secondary" : "btn-outline-primary") rounded-3">
                                    <i class="bi bi-eye me-1"></i>
                                    @(b.OkunduMu ? "Detay" : "Oku & Git")
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

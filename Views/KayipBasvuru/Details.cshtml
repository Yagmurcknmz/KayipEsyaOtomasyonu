@model KayipEsyaOtomasyonu.Models.KayipBildirimi

@{
    ViewData["Title"] = "Başvuru Detayı - " + Model.BasvuruNo;
    var durumlar = ViewBag.Durumlar as IEnumerable<string> ?? Enumerable.Empty<string>();
    var eslesenEsyalar = ViewBag.EslesenEsyalar as IEnumerable<KayipEsyaOtomasyonu.Models.KayipEsya>
        ?? Enumerable.Empty<KayipEsyaOtomasyonu.Models.KayipEsya>();
}

<div class="dashboard-header mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2 small">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="KayipBasvuru" asp-action="Index">Kayıp Başvuruları</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">@Model.BasvuruNo</li>
            </ol>
        </nav>
        <h2>Başvuru Detayı: <small class="text-primary">@Model.BasvuruNo</small></h2>
        <p class="text-muted mb-0">
            @(Model.Vatandas == null
                ? ""
                : $"{Model.Vatandas.Ad} {Model.Vatandas.Soyad} tarafından · " +
                  $"{Model.BasvuruTarihi.ToString("dd.MM.yyyy HH:mm")} oluşturuldu.")
        </p>
    </div>
</div>

<div class="row g-4 mb-4">

    <div class="col-xl-8">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-1">
                    <i class="bi bi-info-circle-fill text-primary me-2"></i>
                    Başvuru Bilgileri
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="small text-muted mb-1 d-block">Başvuru No</label>
                        <strong class="fs-5 text-primary">@Model.BasvuruNo</strong>
                    </div>
                    <div class="col-md-6">
                        <label class="small text-muted mb-1 d-block">Başvuru Tarihi</label>
                        <strong>@Model.BasvuruTarihi.ToString("dd.MM.yyyy HH:mm")</strong>
                    </div>

                    <div class="col-md-6">
                        <label class="small text-muted mb-1 d-block">Eşya Adı</label>
                        <strong>@Model.EsyaAdi</strong>
                    </div>
                    <div class="col-md-6">
                        <label class="small text-muted mb-1 d-block">Kategori</label>
                        <strong>@(Model.Kategori?.Ad ?? "-")</strong>
                    </div>

                    <div class="col-md-4">
                        <label class="small text-muted mb-1 d-block">Marka</label>
                        <strong>@(string.IsNullOrWhiteSpace(Model.Marka) ? "-" : Model.Marka)</strong>
                    </div>
                    <div class="col-md-4">
                        <label class="small text-muted mb-1 d-block">Model</label>
                        <strong>@(string.IsNullOrWhiteSpace(Model.Model) ? "-" : Model.Model)</strong>
                    </div>
                    <div class="col-md-4">
                        <label class="small text-muted mb-1 d-block">Renk</label>
                        <strong>@(string.IsNullOrWhiteSpace(Model.Renk) ? "-" : Model.Renk)</strong>
                    </div>

                    <div class="col-md-6">
                        <label class="small text-muted mb-1 d-block">Kayıp Tarihi</label>
                        <strong>@Model.KayipTarihi.ToString("dd.MM.yyyy")</strong>
                    </div>
                    <div class="col-md-6">
                        <label class="small text-muted mb-1 d-block">Kayıp Yeri</label>
                        <strong>@(string.IsNullOrWhiteSpace(Model.KayipYeri) ? "-" : Model.KayipYeri)</strong>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.AyirtEdiciOzellik))
                    {
                        <div class="col-12">
                            <label class="small text-muted mb-1 d-block">Ayırt Edici Özellikler</label>
                            <p class="mb-0 p-3 bg-light rounded-3">
                                @Model.AyirtEdiciOzellik
                            </p>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Aciklama))
                    {
                        <div class="col-12">
                            <label class="small text-muted mb-1 d-block">Açıklama</label>
                            <p class="mb-0 p-3 bg-light rounded-3">
                                @Model.Aciklama
                            </p>
                        </div>
                    }

                    @if (Model.Enlem.HasValue && Model.Boylam.HasValue)
                    {
                        <div class="col-12">
                            <label class="small text-muted mb-1 d-block">
                                <i class="bi bi-pin-map-fill text-danger me-1"></i>
                                Harita Koordinatları
                            </label>
                            <span class="badge text-bg-light border px-3 py-2 rounded-pill font-monospace">
                                <i class="bi bi-geo-alt text-primary me-1"></i>
                                @Model.Enlem.Value.ToString("F6") , @Model.Boylam.Value.ToString("F6")
                            </span>
                            @if (!string.IsNullOrWhiteSpace(Model.AdresDetayi))
                            {
                                <div class="mt-2 p-3 rounded-3"
                                     style="background:linear-gradient(135deg,#eff6ff 0%,#f0fdfa 100%);">
                                    <div class="d-flex align-items-start gap-2">
                                        <i class="bi bi-signpost-split-fill text-primary fs-5 mt-1"></i>
                                        <div class="flex-grow-1">
                                            <div class="small fw-semibold text-primary mb-1">Açık Adres</div>
                                            <div class="small text-dark mb-0" style="line-height:1.55;">
                                                @Model.AdresDetayi
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(Model.AdresDetayi))
                    {
                        <div class="col-12">
                            <label class="small text-muted mb-1 d-block">
                                <i class="bi bi-signpost-split-fill text-primary me-1"></i>
                                Açık Adres
                            </label>
                            <div class="p-3 rounded-3" style="background:linear-gradient(135deg,#eff6ff 0%,#f0fdfa 100%);">
                                <div class="small text-dark mb-0" style="line-height:1.55;">@Model.AdresDetayi</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @{
            var basvuruResimleri = Model.Resimler?.Where(r => r.AktifMi).OrderBy(r => r.SiraNumarasi).ToList() ?? new List<KayipBildirimiResim>();
        }

        @if (basvuruResimleri.Any())
        {
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-1">
                        <i class="bi bi-images text-success me-2"></i>
                        Başvuruya Ait Fotoğraflar
                        <span class="badge text-bg-success ms-2 rounded-pill">@basvuruResimleri.Count adet</span>
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @for (int i = 0; i < basvuruResimleri.Count; i++)
                        {
                            var r = basvuruResimleri[i];
                            var buyukYol = (!string.IsNullOrWhiteSpace(r.DosyaYolu) ? "/" + r.DosyaYolu.Replace("\\", "/") : "")!;
                            var onizleme = !string.IsNullOrWhiteSpace(r.ThumbnailYolu) ? ("/" + r.ThumbnailYolu.Replace("\\", "/")) : buyukYol;
                            <div class="col-6 col-md-4 col-lg-3">
                                <a href="@buyukYol" target="_blank"
                                   class="d-block text-decoration-none position-relative resim-kart"
                                   style="overflow:hidden;border-radius:18px;box-shadow:0 6px 18px rgba(15,23,42,0.10);">
                                    <img src="@onizleme"
                                         alt="Başvuru Fotoğrafı @(i+1)"
                                         class="img-fluid w-100 object-fit-cover"
                                         style="aspect-ratio:1/1;display:block;cursor:zoom-in;" />
                                    <div class="position-absolute top-2 start-2 d-flex gap-2">
                                        <span class="badge text-bg-dark bg-opacity-80 rounded-pill px-2 py-1 small">
                                            #@(i+1)
                                        </span>
                                        @if (r.VarsayilanResimMi)
                                        {
                                            <span class="badge text-bg-success rounded-pill px-2 py-1 small"
                                                  style="box-shadow:0 4px 10px rgba(22,163,74,0.35);">
                                                <i class="bi bi-star-fill me-1"></i>Kapak
                                            </span>
                                        }
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card border-dashed">
                <div class="card-body text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-image-fill text-muted fs-1 opacity-50"></i>
                    </div>
                    <h6 class="mb-1 text-muted">Bu başvuru için fotoğraf yüklenmemiş</h6>
                    <small class="text-muted opacity-75">Vatandaş başvuru sırasında herhangi bir görsel eklememiş.</small>
                </div>
            </div>
        }

        @if (Model.Enlem.HasValue && Model.Boylam.HasValue)
        {
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-1">
                        <i class="bi bi-map-fill text-danger me-2"></i>
                        Kaybolduğu Konum (Harita)
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div id="harita"
                         class="w-100"
                         style="height:380px;min-height:380px;border-bottom-left-radius:0.5rem;border-bottom-right-radius:0.5rem;"></div>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-1">
                    <i class="bi bi-people-fill text-info me-2"></i>
                    Muhtemel Eşleşen Eşyalar
                </h5>
                <small class="text-muted">
                    Otomatik önerilen @eslesenEsyalar.Count() kayıt
                </small>
            </div>

            <div class="card-body">
                @if (!eslesenEsyalar.Any())
                {
                    <div class="empty-state py-4">
                        <div class="empty-state-icon">
                            <i class="bi bi-search"></i>
                        </div>
                        <h5>Eşleşen kayıt bulunamadı</h5>
                        <p>Bu başvuruyla eşleşebilecek kayıp eşya şu an sistemde mevcut değil.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr class="table-light">
                                    <th>Bulunan Eşya</th>
                                    <th>Kategori</th>
                                    <th>Marka</th>
                                    <th>Bulunma Yeri / Tarihi</th>
                                    <th>Raf No</th>
                                    <th>Durum</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var esya in eslesenEsyalar)
                                {
                                    <tr>
                                        <td><strong>@esya.EsyaAdi</strong></td>
                                        <td>@(esya.Kategori?.Ad ?? "-")</td>
                                        <td>@(string.IsNullOrWhiteSpace(esya.Marka) ? "-" : esya.Marka)</td>
                                        <td>
                                            <div>@(string.IsNullOrWhiteSpace(esya.BulunmaYeri) ? "-" : esya.BulunmaYeri)</div>
                                            <small class="text-muted">@esya.BulunmaTarihi.ToString("dd.MM.yyyy")</small>
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(esya.RafNo) ? "-" : esya.RafNo)</td>
                                        <td>
                                            <span class="badge bg-primary">@esya.Durum</span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="KayipEsya"
                                               asp-action="Details"
                                               asp-route-id="@esya.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

    </div>

    <div class="col-xl-4">

        <div class="card mb-4 border-primary">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-1">
                    <i class="bi bi-gear-wide-connected me-2"></i>
                    Durum Yönetimi
                </h5>
            </div>
            <div class="card-body">
                <form asp-controller="KayipBasvuru"
                      asp-action="DurumDegistir"
                      method="post">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mevcut Durum</label>
                        <select name="durum"
                                class="form-select form-select-lg">
                            @foreach (var durum in durumlar)
                            {
                                <option value="@durum"
                                        selected="@(Model.Durum == durum)">
                                    @durum
                                </option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Admin Notu
                            <small class="text-muted">(Zaman damgası ile kaydedilecektir)</small>
                        </label>
                        <textarea name="adminNotu"
                                  rows="4"
                                  class="form-control"
                                  placeholder="İşlemle ilgili notunuzu buraya yazın... (ör: Vatandaş arandı, geleceğini söyledi)"></textarea>
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        <i class="bi bi-save me-2"></i>
                        Durumu Güncelle
                    </button>

                </form>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-1">
                    <i class="bi bi-person-badge-fill text-success me-2"></i>
                    Başvuran Vatandaş
                </h5>
            </div>
            <div class="card-body">

                @if (Model.Vatandas == null)
                {
                    <p class="text-muted mb-0">Kullanıcı bulunamadı.</p>
                }
                else
                {
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div style="width:58px;height:58px;border-radius:50%;display:grid;place-items:center;
                                    background:#dcfce7;color:#166534;font-size:24px;">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div>
                            <h5 class="mb-0">@Model.Vatandas.Ad @Model.Vatandas.Soyad</h5>
                            <small class="text-muted">
                                @(Model.Vatandas.AktifMi ? "Aktif Hesap" : "Pasif Hesap")
                            </small>
                        </div>
                    </div>

                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted">E-Posta</span>
                            <strong>@Model.Vatandas.Email</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted">Telefon</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.Vatandas.PhoneNumber) ? "-" : Model.Vatandas.PhoneNumber)</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted">Kayıt Tarihi</span>
                            <strong>@Model.Vatandas.KayitTarihi.ToString("dd.MM.yyyy")</strong>
                        </li>
                    </ul>
                }

            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.AdminNotu))
        {
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-1">
                        <i class="bi bi-journal-text text-warning me-2"></i>
                        Geçmiş Notlar
                    </h5>
                </div>
                <div class="card-body">
                    <pre style="white-space:pre-wrap;font-family:inherit;font-size:0.875rem;"
                         class="mb-0 p-3 bg-light border rounded-3">@Model.AdminNotu</pre>
                </div>
            </div>
        }

    </div>

</div>

@section Scripts {
    @if (Model.Enlem.HasValue && Model.Boylam.HasValue)
    {
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
              integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
                integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
        <script>
            (function () {
                var lat = @Model.Enlem.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
                var lng = @Model.Boylam.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
                window.addEventListener('DOMContentLoaded', function () {
                    try {
                        var map = L.map('harita', { scrollWheelZoom: false }).setView([lat, lng], 15);
                        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                            maxZoom: 19,
                            attribution: '&copy; OpenStreetMap'
                        }).addTo(map);
                        var marker = L.marker([lat, lng], { draggable: false }).addTo(map);
                        var popupHtml = '<div style="min-width:180px;padding:4px 2px;"><strong style="color:#dc2626;"><i class="bi bi-geo-alt-fill me-1"></i>Kayıp Yeri</strong><div style="font-size:12px;color:#475569;margin-top:4px;">' +
                            lat.toFixed(5) + ' , ' + lng.toFixed(5) + '</div></div>';
                        marker.bindPopup(popupHtml, { closeButton: false, maxWidth: 300 }).openPopup();
                        setTimeout(function () { map.invalidateSize(true); }, 250);
                    } catch (err) {
                        console.error('Harita yüklenirken hata:', err);
                    }
                });
            })();
        </script>
    }

    <style>
        .resim-kart:hover img {
            transform: scale(1.035);
            transition: transform 0.25s ease;
        }
        .resim-kart img {
            transition: transform 0.25s ease;
        }
        .leaflet-popup-content-wrapper {
            border-radius: 14px !important;
            box-shadow: 0 10px 28px rgba(15, 23, 42, 0.18) !important;
        }
    </style>
}
